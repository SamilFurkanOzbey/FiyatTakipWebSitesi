@code {
    List<FiyatTakipWebSitesi.Models.Urun> urunler = new();
    List<FiyatTakipWebSitesi.Models.Kullanici> kullanicilar = new();
    int secilenUrunId = 0;
    int atanacakUserId = 0;
    decimal yeniFiyat = 0;
    bool yukleniyor = true;
    bool islemDevam = false;
    SonucBilgisi? sonSonuc;

    // Hızlı kullanıcı oluşturma
    bool yeniKullaniciAcik = false;
    bool kullaniciOlusturuluyor = false;
    string yeniAd = "";
    string yeniSoyad = "";
    string yeniEmail = "";
    string yeniSifre = "";
    string kayitMesaji = "";
    bool kayitBasarili = false;

    static readonly System.Globalization.CultureInfo trCulture =
        new System.Globalization.CultureInfo("tr-TR");

    FiyatTakipWebSitesi.Models.Urun? secilenUrun =>
        urunler.FirstOrDefault(u => u.Id == secilenUrunId);

    protected override async Task OnInitializedAsync()
    {
        await VerileriYukle();
    }

    async Task VerileriYukle()
    {
        yukleniyor = true;
        StateHasChanged();

        urunler = await Db.Urunler
            .Include(u => u.Kullanici)
            .Where(u => u.Aktif)
            .OrderByDescending(u => u.UserId.HasValue) // önce kullanıcıya bağlı olanlar
            .ThenBy(u => u.Ad)
            .Take(100)
            .ToListAsync();

        kullanicilar = await Db.Kullanicilar
            .Where(k => k.Aktif)
            .OrderBy(k => k.Email)
            .ToListAsync();

        // Hiç kullanıcı yoksa formu otomatik aç
        if (kullanicilar.Count == 0)
            yeniKullaniciAcik = true;

        yukleniyor = false;
        StateHasChanged();
    }

    void HizliFiyatAyarla(decimal carpan)
    {
        if (secilenUrun is null) return;
        var temel = secilenUrun.SonFiyati > 0 ? secilenUrun.SonFiyati : (secilenUrun.BaslangicFiyati > 0 ? secilenUrun.BaslangicFiyati : 1000m);
        yeniFiyat = Math.Round(temel * carpan, 2);
    }

    async Task KullaniciOlustur()
    {
        if (string.IsNullOrWhiteSpace(yeniAd) || string.IsNullOrWhiteSpace(yeniSoyad)
            || string.IsNullOrWhiteSpace(yeniEmail) || (yeniSifre?.Length ?? 0) < 6) return;

        kullaniciOlusturuluyor = true;
        kayitMesaji = "";
        StateHasChanged();

        try
        {
            var istek = new KayitRequest
            {
                Ad = yeniAd.Trim(),
                Soyad = yeniSoyad.Trim(),
                Email = yeniEmail.Trim(),
                Sifre = yeniSifre!
            };
            var yanit = await KullaniciServisi.KayitAsync(istek);

            kayitBasarili = true;
            kayitMesaji = $"✓ Kullanıcı oluşturuldu: {yanit.Email} (ID: {yanit.KullaniciId})";

            // Formu temizle (şifre alanı güvenlik için)
            yeniAd = ""; yeniSoyad = ""; yeniEmail = ""; yeniSifre = "";
            yeniKullaniciAcik = false;

            await VerileriYukle();

            // Eğer bir ürün zaten seçiliyse ve UserId yoksa, yeni kullanıcıyı seçilecek olarak işaretle
            if (secilenUrun is not null && !secilenUrun.UserId.HasValue)
                atanacakUserId = yanit.KullaniciId;
        }
        catch (InvalidOperationException ex)
        {
            kayitBasarili = false;
            kayitMesaji = $"✗ {ex.Message}";
        }
        catch (Exception ex)
        {
            kayitBasarili = false;
            kayitMesaji = $"✗ Beklenmeyen hata: {ex.Message}";
        }
        finally
        {
            kullaniciOlusturuluyor = false;
            StateHasChanged();
        }
    }

    async Task KullaniciyaBagla()
    {
        if (secilenUrun is null || atanacakUserId == 0) return;

        var urun = await Db.Urunler.FirstOrDefaultAsync(u => u.Id == secilenUrun.Id);
        if (urun is null) return;

        urun.UserId = atanacakUserId;
        await Db.SaveChangesAsync();

        await VerileriYukle();
        secilenUrunId = urun.Id; // seçimi koru
        atanacakUserId = 0;
    }

    async Task Uygula()
    {
        if (secilenUrun is null || yeniFiyat <= 0) return;

        islemDevam = true;
        sonSonuc = null;
        StateHasChanged();

        var eskiFiyat = secilenUrun.SonFiyati;
        var urunId = secilenUrun.Id;
        var userEmail = secilenUrun.Kullanici?.Email;
        var userId = secilenUrun.UserId;

        // Önce mevcut uyarı sayısını öğren (Uygula sonrası farkı bulmak için)
        var oncekiUyariCount = userId.HasValue
            ? await Db.Uyarilar.CountAsync(u => u.UrunId == urunId && u.UserId == userId.Value)
            : 0;

        var basarili = await UrunServisi.FiyatGuncelleAsync(urunId, yeniFiyat, stokVar: true);

        // Yeni uyarıları çek
        var yeniUyarilar = new List<string>();
        if (userId.HasValue)
        {
            yeniUyarilar = await Db.Uyarilar
                .Where(u => u.UrunId == urunId && u.UserId == userId.Value)
                .OrderByDescending(u => u.OlusturulmaTarihi)
                .Take(Math.Max(1, (await Db.Uyarilar.CountAsync(u => u.UrunId == urunId && u.UserId == userId.Value)) - oncekiUyariCount))
                .Select(u => u.Tip.ToString())
                .ToListAsync();
        }

        var degisim = yeniFiyat - eskiFiyat;
        var degisimYuzdesi = eskiFiyat != 0 ? Math.Round((degisim / eskiFiyat) * 100, 1) : 0;

        sonSonuc = new SonucBilgisi
        {
            Basarili = basarili,
            EskiFiyat = eskiFiyat,
            YeniFiyat = yeniFiyat,
            Degisim = degisim,
            DegisimYuzdesi = degisimYuzdesi,
            UyariOlustu = yeniUyarilar.Count > 0,
            UyariCount = yeniUyarilar.Count,
            UyariTipleri = yeniUyarilar,
            KullaniciEmail = userEmail
        };

        await VerileriYukle();
        secilenUrunId = urunId; // seçimi koru
        islemDevam = false;
        StateHasChanged();
    }

    class SonucBilgisi
    {
        public bool Basarili { get; set; }
        public decimal EskiFiyat { get; set; }
        public decimal YeniFiyat { get; set; }
        public decimal Degisim { get; set; }
        public decimal DegisimYuzdesi { get; set; }
        public bool UyariOlustu { get; set; }
        public int UyariCount { get; set; }
        public List<string> UyariTipleri { get; set; } = new();
        public string? KullaniciEmail { get; set; }
    }
}
