@* =====================================================
   DemoPaneli.razor
   Sunum demo'su için: bir ürün seç, kullanıcıya bağla,
   yeni fiyat gir, uygula. UrunService.FiyatGuncelleAsync
   tetiklenir → UyariService uyarı oluşturur ve email
   gönderir. SMTP yapılandırıldıysa gerçek mail gider.
   ===================================================== *@
@page "/demo"
@rendermode InteractiveServer
@inject FiyatTakipWebSitesi.Data.ApplicationDbContext Db
@inject FiyatTakipWebSitesi.Services.UrunService UrunServisi
@inject FiyatTakipWebSitesi.Services.KullaniciService KullaniciServisi
@using Microsoft.EntityFrameworkCore
@using FiyatTakipWebSitesi.DTOs
<PageTitle>Demo Paneli</PageTitle>

<div class="demo-page">

    <header>
        <h1>🎬 Demo Paneli</h1>
        <p>Bir ürün seç, yeni fiyat ver, <strong>Uygula</strong>'ya bas. Fiyat güncellenir, uyarı oluşur, SMTP açıksa kullanıcıya mail gider.</p>
    </header>

    @if (yukleniyor)
    {
        <div class="kart"><p>⏳ Yükleniyor...</p></div>
    }
    else
    {
        @* ── 0) Hızlı Kullanıcı Oluştur ── *@
        <div class="kart kullanici-kart">
            <h2>👤 Kullanıcı Hesabı</h2>
            @if (kullanicilar.Any())
            {
                <p class="bilgi-sat">
                    <strong>@kullanicilar.Count</strong> kayıtlı kullanıcı var:
                    @string.Join(", ", kullanicilar.Take(3).Select(k => k.Email))
                    @(kullanicilar.Count > 3 ? "..." : "")
                </p>
                <button class="btn-ikinci-kucuk" @onclick="() => yeniKullaniciAcik = !yeniKullaniciAcik">
                    @(yeniKullaniciAcik ? "✕ Kapat" : "➕ Yeni kullanıcı ekle")
                </button>
            }
            else
            {
                <p class="uyari-sat">
                    ⚠ <strong>Hiçbir kullanıcı kayıtlı değil.</strong> Mail göndermek için en az 1 kullanıcı gerekli.
                </p>
            }

            @if (yeniKullaniciAcik)
            {
                <div class="hizli-kayit">
                    <div class="form-satir">
                        <input type="text" placeholder="Ad" @bind="yeniAd" class="kayit-input" />
                        <input type="text" placeholder="Soyad" @bind="yeniSoyad" class="kayit-input" />
                    </div>
                    <input type="email" placeholder="E-posta (mail buraya gidecek)" @bind="yeniEmail" class="kayit-input tam-gen" />
                    <input type="password" placeholder="Şifre (en az 6 karakter — sunumda kullanmayacaksın)" @bind="yeniSifre" class="kayit-input tam-gen" />
                    <button class="btn-ana-kucuk" @onclick="KullaniciOlustur"
                            disabled="@(kullaniciOlusturuluyor || string.IsNullOrWhiteSpace(yeniAd) || string.IsNullOrWhiteSpace(yeniSoyad) || string.IsNullOrWhiteSpace(yeniEmail) || (yeniSifre?.Length ?? 0) < 6)">
                        @(kullaniciOlusturuluyor ? "⏳ Oluşturuluyor..." : "✓ Kullanıcıyı Oluştur")
                    </button>
                    @if (!string.IsNullOrEmpty(kayitMesaji))
                    {
                        <p class="@(kayitBasarili ? "kayit-basarili" : "kayit-hata")">@kayitMesaji</p>
                    }
                </div>
            }
        </div>

        @* ── 1) Ürün Seç ── *@
        <div class="kart">
            <h2>1. Ürünü Seç</h2>
            <select @bind="secilenUrunId" class="select-buyuk">
                <option value="0">— Ürün seç —</option>
                @foreach (var u in urunler)
                {
                    var rozet = u.UserId.HasValue ? $"👤 #{u.UserId}" : "⚠ Bağsız";
                    <option value="@u.Id">[@rozet] @u.Ad — @u.Satici (@u.SonFiyati.ToString("N2", trCulture) ₺)</option>
                }
            </select>

            @if (secilenUrun is not null)
            {
                <div class="urun-bilgi">
                    <div class="urun-resim">
                        @if (!string.IsNullOrEmpty(secilenUrun.Resim))
                        {
                            <img src="@secilenUrun.Resim" alt="@secilenUrun.Ad" />
                        }
                        else
                        {
                            <span class="placeholder">🖼️</span>
                        }
                    </div>
                    <div class="urun-detay">
                        <h3>@secilenUrun.Ad</h3>
                        <p><strong>Satıcı:</strong> @secilenUrun.Satici</p>
                        <p><strong>Mevcut fiyat:</strong> <span class="fiyat-mevcut">@secilenUrun.SonFiyati.ToString("N2", trCulture) ₺</span></p>
                        @if (secilenUrun.HedefFiyati.HasValue)
                        {
                            <p><strong>Hedef fiyat:</strong> @secilenUrun.HedefFiyati.Value.ToString("N2", trCulture) ₺</p>
                        }
                        <p>
                            <strong>Kullanıcı:</strong>
                            @if (secilenUrun.UserId.HasValue)
                            {
                                <span class="rozet-ok">✓ #@secilenUrun.UserId — @(secilenUrun.Kullanici?.Email ?? "(email yok)")</span>
                            }
                            else
                            {
                                <span class="rozet-uyari">⚠ Bu ürün hiçbir kullanıcıya bağlı değil — uyarı/email gitmez</span>
                            }
                        </p>
                    </div>
                </div>

                @* Kullanıcıya bağla *@
                @if (!secilenUrun.UserId.HasValue && kullanicilar.Any())
                {
                    <div class="alt-aksiyon">
                        <label><strong>Hangi kullanıcıya bağlayalım?</strong></label>
                        <select @bind="atanacakUserId" class="select-buyuk">
                            <option value="0">— Kullanıcı seç —</option>
                            @foreach (var k in kullanicilar)
                            {
                                <option value="@k.Id">#@k.Id — @k.Email (@k.Ad @k.Soyad)</option>
                            }
                        </select>
                        <button class="btn-ikinci" @onclick="KullaniciyaBagla" disabled="@(atanacakUserId == 0)">
                            🔗 Bağla
                        </button>
                    </div>
                }
            }
        </div>

        @* ── 2) Yeni Fiyat ── *@
        @if (secilenUrun is not null)
        {
            <div class="kart">
                <h2>2. Yeni Fiyat</h2>
                <div class="fiyat-input-grup">
                    <input type="number" step="0.01" min="0"
                           @bind="yeniFiyat" placeholder="0,00"
                           class="fiyat-input" />
                    <span class="para-birimi">₺</span>
                </div>

                <div class="hizli-butonlar">
                    <button class="btn-hizli btn-dusur"
                            @onclick="() => HizliFiyatAyarla(0.90m)"
                            title="Mevcut fiyatın %10 düşüğü">
                        ⬇ %10 indir
                    </button>
                    <button class="btn-hizli btn-dusur"
                            @onclick="() => HizliFiyatAyarla(0.75m)"
                            title="Mevcut fiyatın %25 düşüğü">
                        ⬇⬇ %25 indir
                    </button>
                    @if (secilenUrun.HedefFiyati.HasValue)
                    {
                        <button class="btn-hizli btn-hedef"
                                @onclick="() => yeniFiyat = secilenUrun.HedefFiyati!.Value">
                            🎯 Hedef fiyata in (@secilenUrun.HedefFiyati.Value.ToString("N0", trCulture) ₺)
                        </button>
                    }
                    <button class="btn-hizli btn-artir"
                            @onclick="() => HizliFiyatAyarla(1.10m)"
                            title="Mevcut fiyatın %10 fazlası">
                        ⬆ %10 artır
                    </button>
                </div>

                <button class="btn-ana" @onclick="Uygula"
                        disabled="@(islemDevam || yeniFiyat <= 0)">
                    @if (islemDevam)
                    {
                        <span>⏳ Uygulanıyor...</span>
                    }
                    else
                    {
                        <span>🚀 Uygula (uyarı + email tetiklensin)</span>
                    }
                </button>
            </div>
        }

        @* ── 3) Sonuç ── *@
        @if (sonSonuc is not null)
        {
            <div class="kart sonuc @(sonSonuc.Basarili ? "basarili" : "hatali")">
                <h2>@(sonSonuc.Basarili ? "✅ Sonuç" : "❌ Sonuç")</h2>
                <ul class="sonuc-liste">
                    <li><strong>Eski fiyat:</strong> @sonSonuc.EskiFiyat.ToString("N2", trCulture) ₺</li>
                    <li><strong>Yeni fiyat:</strong> @sonSonuc.YeniFiyat.ToString("N2", trCulture) ₺</li>
                    <li><strong>Değişim:</strong>
                        <span class="@(sonSonuc.Degisim < 0 ? "yesil" : sonSonuc.Degisim > 0 ? "kirmizi" : "")">
                            @(sonSonuc.Degisim > 0 ? "+" : "")@sonSonuc.Degisim.ToString("N2", trCulture) ₺
                            (@(sonSonuc.DegisimYuzdesi > 0 ? "+" : "")@sonSonuc.DegisimYuzdesi.ToString("N1", trCulture)%)
                        </span>
                    </li>
                    <li><strong>Uyarı oluştu mu?</strong>
                        @(sonSonuc.UyariOlustu ? $"✓ Evet ({sonSonuc.UyariCount} adet — {string.Join(", ", sonSonuc.UyariTipleri)})" : "Hayır")
                    </li>
                    <li><strong>Email akışı:</strong>
                        @if (!sonSonuc.UyariOlustu)
                        {
                            <span>Uyarı tetiklenmedi — email gönderilmedi</span>
                        }
                        else if (string.IsNullOrEmpty(sonSonuc.KullaniciEmail))
                        {
                            <span>⚠ Kullanıcı email'i yok</span>
                        }
                        else
                        {
                            <span>✉ @sonSonuc.KullaniciEmail adresine gönderildi (loga bak: <code>[SmtpEmailService] ✓</code>)</span>
                        }
                    </li>
                </ul>
                <p class="ipucu">💡 Aynı ürünü tekrar farklı fiyatla deneyebilirsin — uyarı kuralları dinamik.</p>
            </div>
        }
    }

</div>

