@page "/takip"
@rendermode InteractiveServer
@inject ScraperService Scraper
@inject FiyatTakipWebSitesi.Services.UrunService UrunServisi
@inject FiyatTakipWebSitesi.Services.KategoriService KategoriServisi
@inject FiyatTakipWebSitesi.Services.TakipModeliService TakipModeliServisi
@inject FiyatTakipWebSitesi.Services.OturumDurumu Oturum
@inject FiyatTakipWebSitesi.Data.ApplicationDbContext Db
@inject NavigationManager NavManager
@using Microsoft.EntityFrameworkCore
@implements IDisposable
<PageTitle>Takip Ettiklerim | ŞAM</PageTitle>

@if (!Oturum.GirisYapildi)
{
    <div class="giris-kart">
        <div style="font-size:4rem;margin-bottom:12px;">🔐</div>
        <h2>Giriş Yapmalısın</h2>
        <p>Ürün takip etmek için önce hesap oluşturup giriş yapmalısın.</p>
        <button class="btn-giris" @onclick="GirisGit">🔑 Giriş Yap / Kayıt Ol</button>
    </div>
}
else
{
    <div class="takip-page">

        <header>
            <h1>⭐ Takip Ettiklerim</h1>
            <p class="alt-yazi">
                Takip ettiğin ürünler — fiyat değişiminde e-posta gelir.
                <br />Aşağıdan URL yapıştırarak yeni ürün ekleyebilirsin.
            </p>
        </header>

        @* ── Birleştirme Modal'ı ─────────────────────────── *@
        @if (birlestirAcik && birlestirKaynak is not null)
        {
            <div class="modal-arka" @onclick="BirlestirIptal">
                <div class="modal-kart" @onclick:stopPropagation="true">
                    <div class="modal-ikon">🔗</div>
                    <h3>Modelleri Birleştir</h3>
                    <p class="modal-aciklama">
                        <strong>@birlestirKaynak.ModelAd</strong> ürününü başka bir modelin altına taşı.
                        Tüm listingleri (siteleri) hedef modele aktarılır, bu model silinir.
                    </p>

                    <label class="modal-label">Hedef Model</label>
                    <select class="modal-select" @bind="birlestirHedefId" disabled="@birlestirIslemDevam">
                        <option value="0">— Hedef model seç —</option>
                        @foreach (var k in modelKartlar.Where(x => x.ModelId != birlestirKaynak.ModelId))
                        {
                            var benzerlik = IsimBenzerlikSkoru(birlestirKaynak.ModelAd, k.ModelAd);
                            var yuzde = Math.Round(benzerlik * 100, 0);
                            <option value="@k.ModelId">
                                @(yuzde > 30 ? $"⭐ %{yuzde} " : "") @k.ModelAd
                            </option>
                        }
                    </select>

                    <div class="modal-btnler">
                        <button class="modal-btn evet"
                                @onclick="BirlestirOnayla"
                                disabled="@(birlestirHedefId == 0 || birlestirIslemDevam)">
                            @(birlestirIslemDevam ? "⏳ Birleştiriliyor..." : "🔗 Birleştir")
                        </button>
                        <button class="modal-btn hayir"
                                @onclick="BirlestirIptal"
                                disabled="@birlestirIslemDevam">
                            İptal
                        </button>
                    </div>
                </div>
            </div>
        }

        @* ── Kategori Uyarı Modal'ı ── *@
        @if (kategoriUyariGoster && bekleyenDetay is not null)
        {
            <div class="modal-arka" @onclick="UyariIptal">
                <div class="modal-kart" @onclick:stopPropagation="true">
                    <div class="modal-ikon">⚠️</div>
                    <h3>Kategori Uyuşmazlığı</h3>
                    <p class="modal-aciklama">
                        "<strong>@bekleyenDetay.Ad</strong>" ürünü,
                        seçili <strong>@secilenKategori</strong> kategorisi yerine
                        <strong>@kategoriOnerilen</strong> kategorisine daha uygun görünüyor.
                    </p>
                    <div class="modal-btnler">
                        <button class="modal-btn evet" @onclick="KategoriDuzeltVeKaydet">
                            ✅ @kategoriOnerilen olarak ekle
                        </button>
                        <button class="modal-btn" style="background:#334155;color:#cbd5e1;" @onclick="UrunKaydet">
                            Yine de @secilenKategori ekle
                        </button>
                        <button class="modal-btn hayir" @onclick="UyariIptal">
                            ❌ İptal
                        </button>
                    </div>
                </div>
            </div>
        }

        @* ── URL EKLE — Kategori Seçimi Geri Geldi ──────────────────── *@
        <section class="ekle-kutu">
            <h3>🔗 URL ile Ekle</h3>
            <p class="kucuk-aciklama">
                Hepsiburada / Çiçeksepeti / Teknosa / n11 / PttAVM ürün linkini yapıştır,
                sistem otomatik adı, fiyatı ve resmi çeker.
            </p>

            <div class="form-satir">
                <input @bind="yeniLink"
                       @bind:event="oninput"
                       @onkeydown="EnterTusu"
                       placeholder="Ürün linkini yapıştır..."
                       class="link-input"
                       disabled="@yukleniyor" />

                @* KATEGORİ SEÇİMİ (Geri Getirildi) *@
                <select @bind="secilenKategori" class="kategori-select" disabled="@yukleniyor">
                    @foreach (var k in kategoriler)
                    {
                        <option value="@k">@k</option>
                    }
                </select>

                <button class="btn-ekle"
                        @onclick="UrunEkle"
                        disabled="@(yukleniyor || string.IsNullOrWhiteSpace(yeniLink))">
                    @(yukleniyor ? "⏳ Ekleniyor..." : "➕ Ekle")
                </button>
            </div>

            @if (yukleniyor)
            {
                <div class="adim-blok">
                    <div class="adim-baslik">
                        <div class="donus-cember"></div>
                        <div>
                            <p class="adim-h"><strong>Ürün bilgileri çekiliyor</strong></p>
                            <p class="adim-sub">Bu işlem 5–10 saniye sürebilir</p>
                        </div>
                    </div>
                    <div class="adim-liste">
                        @foreach (var a in adimlar)
                        {
                            <div class="adim-satir">
                                <span class="adim-ikon">
                                    @if (a.Durum == AdimDurum.Tamamlandi) { <text>✅</text> }
                                    else if (a.Durum == AdimDurum.Devam) { <span class="nokta-anim">⚙️</span> }
                                    else { <span style="opacity:0.3">○</span> }
                                </span>
                                <span class="adim-yazi @(a.Durum == AdimDurum.Devam ? "devam" : "")">
                                    @a.Metin
                                </span>
                            </div>
                        }
                    </div>
                    <div class="ilerleme-cubuk">
                        <div class="ilerleme-bar" style="width:@(ilerleme)%"></div>
                    </div>
                    <p class="ilerleme-yuzde">%@ilerleme</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(mesaj) && !yukleniyor)
            {
                <div class="@(hataVar ? "mesaj-hata" : "mesaj-basari")">
                    @if (hataVar && zatenVarModelId > 0)
                    {
                        <span>⚠ Bu URL zaten takip listende. </span>
                        <NavLink href="@($"/model/{zatenVarModelId}")" class="mesaj-link">Ürünü gör →</NavLink>
                    }
                    else
                    {
                        @mesaj
                    }
                </div>
            }
        </section>

        @* ── Takip ettiklerin — Daraltılmış Kartlar ─────────────────── *@
        <section>
            @if (modelKartlar.Count == 0)
            {
                <div class="bos-kucuk">
                    Henüz kategorilerden takibe aldığın model yok.
                    <a href="/kategoriler">Kategorilere git</a>
                </div>
            }
            else
            {
                <div class="model-listesi">
                    @foreach (var k in modelKartlar)
                    {
                        <div class="model-kart" @onclick="() => Detaya(k.ModelId)">
                            <div class="takipte-rozet">📌 TAKİPTE</div>

                            <div class="kart-resim">
                                @if (!string.IsNullOrEmpty(k.Resim))
                                {
                                    <img src="@k.Resim" alt="@k.ModelAd" />
                                }
                                else
                                {
                                    <span class="placeholder">🖼️</span>
                                }
                            </div>

                            <div class="kart-icerik">
                                <span class="kategori-rozet">@k.KategoriAd</span>
                                <h4 title="@k.ModelAd">@k.ModelAd</h4>

                                @if (k.EnUcuzFiyat.HasValue)
                                {
                                    <div class="fiyat-kutu">
                                        <span class="fiyat-etiket">EN UCUZ</span>
                                        <span class="fiyat-deger">@k.EnUcuzFiyat.Value.ToString("N2", trCulture) ₺</span>
                                        <span class="fiyat-satici">🏪 @k.EnUcuzSatici</span>
                                    </div>
                                    <div class="site-bilgi">📍 @k.ToplamSite sitede izleniyor</div>
                                }
                                else
                                {
                                    <div class="fiyat-kutu bekleniyor-kutu">
                                        <span class="fiyat-etiket">DURUM</span>
                                        <span class="fiyat-deger sari">Fiyat bekleniyor</span>
                                    </div>
                                    <div class="site-bilgi">📍 @k.ToplamSite sitede izleniyor</div>
                                }

                                <div class="btn-row" @onclick:stopPropagation="true">
                                    <button class="btn-detay" @onclick="() => Detaya(k.ModelId)">📄 Detay</button>
                                    @if (k.EnUcuzUrunId > 0)
                                    {
                                        <button class="btn-grafik" @onclick="() => Grafige(k.EnUcuzUrunId)">📊 Grafik</button>
                                    }
                                </div>
                                @if (modelKartlar.Count > 1)
                                {
                                    <button class="btn-birlestir"
                                            @onclick="() => BirlestirAc(k)"
                                            @onclick:stopPropagation="true">
                                        🔗 Başka modelle birleştir
                                    </button>
                                }
                                <button class="btn-cik-tam"
                                        @onclick="() => ModelTakipCik(k)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(islemModelId == k.TakipId)">
                                    @(islemModelId == k.TakipId ? "⏳ Kaldırılıyor..." : "✕ Takipten Çık")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

<style>
    body { background: #202022; }

    .giris-kart {
        max-width: 500px; margin: 60px auto;
        background: #252526; border: 1px solid #4a4a4c;
        border-radius: 20px; padding: 50px 30px;
        color: white; text-align: center;
    }
    .giris-kart h2 { color: #f1f5f9; margin: 0 0 12px; }
    .giris-kart p { color: #94a3b8; line-height: 1.6; }
    .btn-giris {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: white; border: none; padding: 14px 28px;
        border-radius: 10px; font-weight: 700; cursor: pointer;
    }

    .takip-page { padding: 28px 32px; width: 100%; color: white; background: #202022; }
    header h1 { font-size: 1.9rem; margin: 0 0 6px; color: #f1f5f9; }
    .alt-yazi { color: #94a3b8; margin: 0 0 20px; line-height: 1.5; }

    /* ── Benzer model modal ── */
    .modal-arka {
        position: fixed; inset: 0;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(4px);
        display: flex; align-items: center; justify-content: center;
        z-index: 1000;
        animation: fadeIn 0.2s;
    }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .modal-kart {
        background: #1e293b;
        border: 1px solid #38bdf8;
        border-radius: 18px;
        padding: 32px 28px;
        max-width: 600px;
        width: 92%;
        box-shadow: 0 20px 60px rgba(0,0,0,0.6);
        text-align: center;
    }
    .modal-ikon { font-size: 3rem; margin-bottom: 10px; }
    .modal-kart h3 { color: #f1f5f9; margin: 0 0 10px; font-size: 1.35rem; }
    .modal-aciklama { color: #cbd5e1; line-height: 1.5; margin: 0 0 22px; }
    
    .modal-btnler { display: flex; gap: 10px; flex-wrap: wrap; }
    .modal-btn {
        flex: 1; padding: 14px;
        border-radius: 10px; border: none;
        cursor: pointer; font-weight: 700;
        display: flex; flex-direction: column; gap: 2px;
        transition: all 0.2s;
    }
    .modal-btn.evet { background: linear-gradient(135deg, #16a34a, #15803d); color: white; }
    .modal-btn.hayir { background: #334155; color: #cbd5e1; border: 1px solid #475569; }

    /* ── URL ekleme kutusu ── */
    .ekle-kutu {
        background: #2a2a2e;
        border: 1px solid #4a4a4c;
        border-radius: 16px; 
        padding: 22px 26px;
        margin-bottom: 30px;
        max-width: 65%; /* Kategori eklendiği için kutuyu biraz genişlettik */
    }
    @@media (max-width: 900px) {
        .ekle-kutu { max-width: 100%; }
        .form-satir { flex-wrap: wrap; }
    }

    .ekle-kutu h3 { margin: 0 0 4px; color: #ffffff; font-size: 1.1rem; }
    .kucuk-aciklama { color: #b3b3b3; font-size: 0.88rem; margin: 0 0 14px; }
    
    .form-satir { 
        display: flex; 
        gap: 10px; 
        align-items: center; 
    }
    .link-input {
        flex: 1; 
        background: #3e3e42; 
        color: white;
        border: 1px solid #5c5c5c; 
        border-radius: 10px;
        padding: 11px 14px; 
        font-size: 0.95rem;
    }
    .link-input:focus { outline: none; border-color: #9ba4b5; }
    
    /* Geri Gelen Kategori Seçim Kutusu Stili */
    .kategori-select {
        background: #3e3e42; 
        color: white;
        border: 1px solid #5c5c5c; 
        border-radius: 10px;
        padding: 11px 14px; 
        font-size: 0.95rem;
        cursor: pointer;
    }
    .kategori-select:focus { outline: none; border-color: #9ba4b5; }

    .btn-ekle {
        background: #17a2b8; 
        color: white; border: none;
        padding: 11px 20px; border-radius: 10px;
        font-weight: 700; cursor: pointer; transition: all 0.2s;
    }
    .btn-ekle:hover:not(:disabled) { background: #138496; transform: translateY(-2px); }
    .btn-ekle:disabled { opacity: 0.5; cursor: not-allowed; }

    .adim-blok {
        margin-top: 18px; padding: 18px;
        background: #202022; border-radius: 12px;
        border: 1px solid #4a4a4c;
    }
    .adim-baslik { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .adim-h { margin: 0; color: white; font-size: 1rem; }
    .adim-sub { margin: 0; color: #9ba4b5; font-size: 0.78rem; }
    .adim-liste { display: flex; flex-direction: column; gap: 8px; }
    .adim-satir { display: flex; align-items: center; gap: 10px; }
    .adim-ikon { width: 22px; text-align: center; }
    .adim-yazi { color: #b3b3b3; font-size: 0.88rem; }
    .adim-yazi.devam { color: #17a2b8; }
    .ilerleme-cubuk {
        margin-top: 14px; background: #3e3e42;
        border-radius: 999px; height: 6px; overflow: hidden;
    }
    .ilerleme-bar {
        height: 100%; border-radius: 999px;
        background: #17a2b8;
        transition: width 0.6s ease;
    }
    .ilerleme-yuzde { margin: 4px 0 0; font-size: 0.75rem; color: #b3b3b3; text-align: right; }

    .donus-cember {
        width: 32px; height: 32px;
        border: 3px solid #3e3e42; border-top-color: #17a2b8;
        border-radius: 50%; animation: don 0.8s linear infinite;
        flex-shrink: 0;
    }
    .nokta-anim { display: inline-block; animation: don 1.2s linear infinite; }
    @@keyframes don { to { transform: rotate(360deg); } }

    .mesaj-basari { color: #4ade80; background: rgba(74, 222, 128, 0.1); padding: 12px 16px; border-radius: 8px; margin-top: 12px; border-left: 3px solid #16a34a; }
    .mesaj-hata { color: #fca5a5; background: rgba(239, 68, 68, 0.1); padding: 12px 16px; border-radius: 8px; margin-top: 12px; border-left: 3px solid #dc2626; }
    .mesaj-link { color: #38bdf8; font-weight: 700; text-decoration: underline; }

    .bos-kucuk {
        background: #252526; border: 1px dashed #4a4a4c;
        border-radius: 12px; padding: 28px;
        color: #b3b3b3; text-align: center;
    }
    .bos-kucuk a { color: #17a2b8; text-decoration: none; margin-left: 6px; }
    .bos-kucuk a:hover { text-decoration: underline; }

    /* ── Daraltılmış Takip Kartları ── */
    .model-listesi {
        display: grid;
        /* Kartların min genişliği 200px'e çekildi, yan yana daha fazla kart sığar */
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));   
        gap: 18px;
        margin-bottom: 32px;
    }

    .model-kart {
        position: relative;
        background: #252526;
        border: 1px solid #4a4a4c;
        border-left: 4px solid #16a34a;   
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex; flex-direction: column;
    }
    .model-kart:hover {
        transform: translateY(-3px);
        border-color: #4ade80;
        border-left-color: #4ade80;
        box-shadow: 0 10px 24px rgba(74, 222, 128, 0.18);
    }

    .takipte-rozet {
        position: absolute; top: 10px; right: 10px;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: white;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        box-shadow: 0 2px 8px rgba(22, 163, 74, 0.5);
        z-index: 2;
    }

    .kart-resim {
        width: 100%; height: 150px; /* Dar kartlara uygun oran */
        background: white;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
    }
    .kart-resim img { max-width: 100%; max-height: 100%; object-fit: contain; padding: 12px; }
    .placeholder { font-size: 3rem; opacity: 0.4; }

    .kart-icerik {
        padding: 14px;
        display: flex; flex-direction: column; gap: 8px;
        flex: 1;
    }
    .kategori-rozet {
        align-self: flex-start;
        background: #202022; color: #b3b3b3;
        padding: 3px 10px; border-radius: 6px;
        font-size: 0.7rem; font-weight: 600;
        border: 1px solid #4a4a4c;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }
    .kart-icerik h4 {
        margin: 2px 0 4px; color: #f1f5f9;
        font-size: 0.95rem; font-weight: 700; line-height: 1.3;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden; min-height: 2.6em;
    }

    .fiyat-kutu {
        background: rgba(22, 163, 74, 0.1);
        border: 1px solid #16a34a;
        border-radius: 10px;
        padding: 10px 12px;
        display: flex; flex-direction: column; gap: 2px;
        margin: 4px 0 4px;
    }
    .fiyat-kutu.bekleniyor-kutu {
        background: rgba(245, 158, 11, 0.1);
        border-color: #f59e0b;
    }
    .fiyat-etiket {
        color: #4ade80; font-size: 0.65rem;
        font-weight: 700; letter-spacing: 0.7px;
    }
    .bekleniyor-kutu .fiyat-etiket { color: #fbbf24; }
    .fiyat-deger {
        color: #4ade80;
        font-size: 1.25rem; /* Genişlik daraldığı için font boyutu hafif küçültüldü */
        font-weight: 800;
        line-height: 1.1;
    }
    .fiyat-deger.sari { color: #fbbf24; font-size: 0.95rem; font-style: italic; }
    .fiyat-satici { color: #86efac; font-size: 0.74rem; margin-top: 2px; }
    
    .site-bilgi {
        color: #b3b3b3; background: #202022;
        padding: 5px 10px; border-radius: 6px;
        font-size: 0.74rem; border: 1px solid #4a4a4c;
        text-align: center;
    }

    .btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 6px; }
    .btn-detay, .btn-grafik {
        padding: 8px; border-radius: 6px; border: none;
        cursor: pointer; font-size: 0.78rem; font-weight: 600;
        transition: filter 0.2s; text-align: center;
    }
    .btn-detay { background: #4a4a4c; color: white; }
    .btn-grafik { background: #17a2b8; color: white; }
    .btn-detay:hover, .grafik-btn:hover { filter: brightness(1.15); }

    .btn-cik-tam {
        width: 100%; margin-top: 2px;
        background: transparent; color: #f87171;
        border: 1px solid #7f1d1d;
        padding: 7px; border-radius: 6px;
        font-size: 0.76rem; font-weight: 600; cursor: pointer;
        transition: all 0.2s;
    }
    .btn-cik-tam:hover:not(:disabled) {
        background: #450a0a; color: #fca5a5;
        border-color: #dc2626;
    }
    .btn-cik-tam:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-birlestir {
        width: 100%; margin-top: 4px;
        background: transparent;
        color: #17a2b8;
        border: 1px dashed #4a4a4c;
        padding: 6px;
        border-radius: 6px;
        font-size: 0.74rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-birlestir:hover {
        background: #252526;
        border-color: #17a2b8;
        color: #48c6ef;
    }

    /* Modal label + select (birleştirme) */
    .modal-label {
        display: block;
        text-align: left;
        color: #b3b3b3;
        font-size: 0.82rem;
        font-weight: 600;
        margin: 0 0 6px;
    }
    .modal-select {
        width: 100%;
        background: #202022; color: white;
        border: 1px solid #4a4a4c;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 0.92rem;
        margin-bottom: 22px;
    }
    .modal-select:focus { outline: none; border-color: #17a2b8; }

</style>

@code {
    static readonly System.Globalization.CultureInfo trCulture = new("tr-TR");

    enum AdimDurum { Bekliyor, Devam, Tamamlandi }
    class Adim
    {
        public string Metin { get; set; } = "";
        public AdimDurum Durum { get; set; } = AdimDurum.Bekliyor;
    }

    List<Adim> adimlar = new()
    {
        new() { Metin = "Katalogda taranıyor" },
        new() { Metin = "Bağlantı kuruluyor" },
        new() { Metin = "Ürün adı ve fiyat okunuyor" },
        new() { Metin = "Resim ve satıcı bilgisi alınıyor" },
    };
    int ilerleme = 0;

    List<Models.Kategori> dbKategoriler = new();
    
    /* Geri Eklenen Kategori Listesi ve Seçimi */
    List<string> kategoriler = new();
    string secilenKategori = "";
    
    string yeniLink = "";
    string mesaj = "";
    bool hataVar = false;
    bool yukleniyor = false;

    List<TakipModelKart> modelKartlar = new();
    int? islemModelId = null;

    bool birlestirAcik = false;
    TakipModelKart? birlestirKaynak = null;
    int birlestirHedefId = 0;
    bool birlestirIslemDevam = false;

    bool kategoriUyariGoster = false;
    string kategoriOnerilen = "";
    UrunDetay? bekleyenDetay;
    int bekleyenKatId;
    int zatenVarModelId = 0;

    protected override async Task OnInitializedAsync()
    {
        Oturum.Degisti += StateHasChanged;

        dbKategoriler = await KategoriServisi.GetAllAsync();
        if (dbKategoriler.Count == 0)
        {
            await KategoriServisi.SeedVarsayilanKategorilerAsync();
            dbKategoriler = await KategoriServisi.GetAllAsync();
        }

        /* Veritabanındaki kategorilerin adlarını Dropdown için ayır */
        kategoriler = dbKategoriler.Select(k => k.Ad).ToList();
        if (kategoriler.Any()) secilenKategori = kategoriler.First();

        if (Oturum.GirisYapildi)
            await VerileriYukle();
    }

    public void Dispose() => Oturum.Degisti -= StateHasChanged;

    async Task VerileriYukle()
    {
        if (!Oturum.GirisYapildi) return;
        var uid = Oturum.KullaniciId!.Value;
        modelKartlar = await TakipModeliServisi.GetKullaniciKartlariAsync(uid);
    }

    async Task EnterTusu(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UrunEkle();
    }

    async Task UrunEkle()
    {
        if (string.IsNullOrWhiteSpace(yeniLink)) return;

        var temizLink = yeniLink.Trim();

        var urlHatasi = ScraperService.UrunUrlHatasi(temizLink);
        if (urlHatasi != null)
        {
            mesaj = urlHatasi; hataVar = true; return;
        }

        var uid0 = Oturum.KullaniciId!.Value;
        zatenVarModelId = 0;
        var zatenVarUrun = await Db.Urunler
            .FirstOrDefaultAsync(u => u.URL == temizLink && u.UserId == uid0 && u.Aktif);
        if (zatenVarUrun is not null && zatenVarUrun.UrunModeliId.HasValue)
        {
            var modelId = zatenVarUrun.UrunModeliId.Value;
            var aktifTakipVar = await Db.TakipModelleri.AnyAsync(t =>
                t.UserId == uid0 && t.UrunModeliId == modelId && t.Aktif);

            if (aktifTakipVar)
            {
                zatenVarModelId = modelId;
                mesaj = "⚠ Bu URL zaten takip listende.";
                hataVar = true;
                return;
            }

            // Urun ekli ama takipte değil — sessizce yeniden takibe al, scrape gereksiz
            await TakipModeliServisi.TakipEkleAsync(uid0, modelId);
            await VerileriYukle();
            yeniLink = "";
            mesaj = $"✅ \"{zatenVarUrun.Ad}\" yeniden takibe alındı.";
            hataVar = false;
            return;
        }

        var siteAdi = ScraperService.SiteAdi(ScraperService.SiteTespit(temizLink));
        adimlar[1].Metin = $"{siteAdi} sayfasına gidiliyor";
        foreach (var a in adimlar) a.Durum = AdimDurum.Bekliyor;
        ilerleme = 0;
        yukleniyor = true;
        mesaj = "";
        hataVar = false;

        var scrapeGorev = Scraper.GetUrunDetayAsync(temizLink);
        int[] bekleme = { 800, 1200, 1500, 1000 };
        for (int i = 0; i < adimlar.Count; i++)
        {
            adimlar[i].Durum = AdimDurum.Devam;
            ilerleme = (i + 1) * 25;
            StateHasChanged();
            await Task.Delay(bekleme[i]);
            if (scrapeGorev.IsCompleted) break;
            adimlar[i].Durum = AdimDurum.Tamamlandi;
        }

        try
        {
            var detay = await scrapeGorev;
            foreach (var a in adimlar) a.Durum = AdimDurum.Tamamlandi;
            ilerleme = 100;
            yukleniyor = false;
            StateHasChanged();
            await Task.Delay(400);

            var kat = dbKategoriler.FirstOrDefault(k => k.Ad == secilenKategori) ?? dbKategoriler.FirstOrDefault();
            bekleyenDetay = detay;
            bekleyenKatId = kat?.Id ?? 1;

            // Kategori uyuşmazlığı kontrolü — uyuşmuyorsa modal göster, bekle
            var onerilen = KategoriUyumsuzlugu(detay.Ad, secilenKategori);
            if (onerilen is not null)
            {
                kategoriOnerilen = onerilen;
                kategoriUyariGoster = true;
                return;
            }

            await UrunKaydet();
        }
        catch (Exception ex)
        {
            mesaj = $"Hata: {ex.Message}";
            hataVar = true;
        }
        finally
        {
            yukleniyor = false;
        }
    }

    async Task UrunKaydet()
    {
        kategoriUyariGoster = false;
        if (bekleyenDetay is null) return;

        var detay = bekleyenDetay;
        var katId = bekleyenKatId;

        try
        {
            var tumModeller = await Db.UrunModelleri.AsNoTracking().ToListAsync();
            var mevcutModel = tumModeller.FirstOrDefault(m =>
                string.Equals(m.Ad.Trim(), detay.Ad.Trim(), StringComparison.OrdinalIgnoreCase));

            int modelId;
            bool yeniModelOlustu = false;

            if (mevcutModel is not null)
            {
                modelId = mevcutModel.Id;
            }
            else
            {
                var yeniModel = new Models.UrunModeli
                {
                    Ad = detay.Ad,
                    KategoriId = katId,
                    Resim = detay.ResimUrl,
                    OlusturulmaTarihi = DateTime.UtcNow,
                    Aktif = true,
                };
                Db.UrunModelleri.Add(yeniModel);
                await Db.SaveChangesAsync();
                modelId = yeniModel.Id;
                yeniModelOlustu = true;
            }

            // Yarış: UrunEkle ön kontrolünden sonra başka bir akış URL'yi eklemiş olabilir.
            // Bu noktada aktif Urun varsa, sadece TakipModeli reaktive et ve çık.
            var araVarUrun = await Db.Urunler
                .FirstOrDefaultAsync(u => u.URL == detay.Url && u.UserId == Oturum.KullaniciId && u.Aktif);
            if (araVarUrun is not null && araVarUrun.UrunModeliId.HasValue)
            {
                await TakipModeliServisi.TakipEkleAsync(Oturum.KullaniciId!.Value, araVarUrun.UrunModeliId.Value);
                await VerileriYukle();
                yeniLink = "";
                bekleyenDetay = null;
                mesaj = $"✅ \"{araVarUrun.Ad}\" takip listene eklendi.";
                hataVar = false;
                return;
            }

            var yeniUrun = new Models.Urun
            {
                Ad = detay.Ad,
                URL = detay.Url,
                Resim = detay.ResimUrl,
                Satici = detay.Satici,
                BaslangicFiyati = detay.FiyatSayi,
                SonFiyati = detay.FiyatSayi,
                ParaBirimi = "TRY",
                KategoriId = katId,
                UserId = Oturum.KullaniciId,
                UrunModeliId = modelId,
            };

            await UrunServisi.EkleAsync(yeniUrun);
            await TakipModeliServisi.TakipEkleAsync(Oturum.KullaniciId!.Value, modelId);
            await VerileriYukle();

            yeniLink = "";
            bekleyenDetay = null;
            mesaj = yeniModelOlustu
                ? $"✅ \"{detay.Ad}\" takip listene eklendi!"
                : $"✅ \"{detay.Ad}\" takip listene eklendi (katalogdaki modele bağlandı)";
            hataVar = false;
        }
        catch (Exception ex)
        {
            mesaj = $"Hata: {ex.Message}";
            hataVar = true;
        }
    }

    async Task KategoriDuzeltVeKaydet()
    {
        var onerilen = dbKategoriler.FirstOrDefault(k => k.Ad == kategoriOnerilen);
        if (onerilen is not null)
        {
            secilenKategori = onerilen.Ad;
            bekleyenKatId = onerilen.Id;
        }
        await UrunKaydet();
    }

    void UyariIptal()
    {
        kategoriUyariGoster = false;
        bekleyenDetay = null;
        mesaj = "❌ Ekleme iptal edildi.";
        hataVar = true;
    }

    static string? KategoriUyumsuzlugu(string urunAd, string secilenKat)
    {
        var adKucuk = urunAd.ToLowerInvariant();
        string? enIyiKat = null;
        int enYuksekPuan = 0;

        foreach (var (kat, anahtarlar) in KategoriAnahtarlar)
        {
            var puan = anahtarlar.Count(a => adKucuk.Contains(a));
            if (puan > enYuksekPuan)
            {
                enYuksekPuan = puan;
                enIyiKat = kat;
            }
        }

        if (enIyiKat is not null && enYuksekPuan > 0 &&
            !string.Equals(enIyiKat, secilenKat, StringComparison.OrdinalIgnoreCase))
            return enIyiKat;

        return null;
    }

    static readonly Dictionary<string, string[]> KategoriAnahtarlar =
        new(StringComparer.OrdinalIgnoreCase)
    {
        ["Elektronik"] = [
            "telefon", "laptop", "bilgisayar", "tablet", "kulaklık", "klavye",
            "mouse", "ekran", "monitör", "televizyon", "iphone", "samsung", "xiaomi",
            "huawei", "şarj", "router", "modem", "yazıcı", "kamera", "drone",
            "notebook", "işlemci", "grafik kartı", "akıllı saat", "bluetooth",
            "airpod", "playstation", "xbox", "nintendo", "oyun konsol", "ssd", "ram",
        ],
        ["Ev & Yaşam"] = [
            "buzdolabı", "çamaşır makinesi", "bulaşık makinesi", "fırın", "ocak",
            "süpürge", "aspiratör", "çaydanlık", "kettle", "airfryer", "tencere",
            "tava", "mutfak robotu", "blender", "mikser", "ütü", "klima",
            "vantilatör", "halı", "perde", "nevresim", "koltuk",
        ],
        ["Moda"] = [
            "ayakkabı", "terlik", "bot", "sandalet", "elbise", "gömlek", "pantolon",
            "tişört", "kazak", "mont", "ceket", "çanta", "spor ayakkabı", "nike",
            "adidas", "puma", "converse", "vans", "fila", "kemer", "hoodie",
        ],
        ["Kozmetik"] = [
            "parfüm", "krem", "serum", "maskara", "ruj", "fondöten", "şampuan",
            "saç boyası", "cilt bakım", "losyon", "deodorant", "nivea", "garnier",
            "maybelline", "makyaj", "nemlendirici", "güneş kremi",
        ],
        ["Otomotiv"] = [
            "motor yağı", "lastik", "jant", "akü", "fren", "yağ filtresi",
            "hava filtresi", "silecek", "castrol", "koltuk kılıfı",
            "araç aksesuarı", "araba aksesuar",
        ],
    };

    static decimal IsimBenzerlikSkoru(string a, string b)
    {
        var tokA = Tokenize(a);
        var tokB = Tokenize(b);
        if (tokA.Count == 0 || tokB.Count == 0) return 0;
        var kesisim = tokA.Intersect(tokB).Count();
        return (decimal)(2.0 * kesisim) / (tokA.Count + tokB.Count);
    }

    static HashSet<string> Tokenize(string s) =>
        new string(s.ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) ? c : ' ').ToArray())
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(t => t.Length > 1)
            .ToHashSet();

    void BirlestirAc(TakipModelKart kart)
    {
        birlestirKaynak = kart;
        birlestirHedefId = 0;
        birlestirAcik = true;
        StateHasChanged();
    }

    void BirlestirIptal()
    {
        birlestirAcik = false;
        birlestirKaynak = null;
        birlestirHedefId = 0;
    }

    async Task BirlestirOnayla()
    {
        if (birlestirKaynak is null || birlestirHedefId == 0) return;
        birlestirIslemDevam = true;
        StateHasChanged();

        try
        {
            var kaynakUrunler = await Db.Urunler
                .Where(u => u.UrunModeliId == birlestirKaynak.ModelId)
                .ToListAsync();

            foreach (var u in kaynakUrunler)
                u.UrunModeliId = birlestirHedefId;
            await Db.SaveChangesAsync();

            var kaynakTakipler = await Db.TakipModelleri
                .Where(t => t.UrunModeliId == birlestirKaynak.ModelId)
                .ToListAsync();
            Db.TakipModelleri.RemoveRange(kaynakTakipler);

            var kaynakModel = await Db.UrunModelleri.FirstOrDefaultAsync(m => m.Id == birlestirKaynak.ModelId);
            if (kaynakModel is not null)
                Db.UrunModelleri.Remove(kaynakModel);

            await Db.SaveChangesAsync();

            var uid = Oturum.KullaniciId!.Value;
            await TakipModeliServisi.TakipEkleAsync(uid, birlestirHedefId);

            mesaj = "✅ Model başarıyla birleştirildi.";
            hataVar = false;
            birlestirAcik = false;
            birlestirKaynak = null;
            birlestirHedefId = 0;

            await VerileriYukle();
        }
        catch (Exception ex)
        {
            mesaj = "✗ Birleştirme başarısız oldu.";
            hataVar = true;
            Console.Error.WriteLine($"[Birleştir] {ex}");
        }
        finally
        {
            birlestirIslemDevam = false;
            StateHasChanged();
        }
    }

    async Task ModelTakipCik(TakipModelKart kart)
    {
        islemModelId = kart.TakipId;
        StateHasChanged();
        try
        {
            await TakipModeliServisi.TakiptenCikAsync(Oturum.KullaniciId!.Value, kart.ModelId);
            modelKartlar = modelKartlar.Where(k => k.TakipId != kart.TakipId).ToList();
        }
        finally
        {
            islemModelId = null;
            StateHasChanged();
        }
    }

    void Detaya(int modelId) => NavManager.NavigateTo($"/model/{modelId}");
    void Grafige(int urunId) => NavManager.NavigateTo($"/grafik/{urunId}");
    void GirisGit() => NavManager.NavigateTo("/hesap");

    static string SiteIkon(string satici) => satici.ToLowerInvariant() switch
    {
        var s when s.Contains("hepsi")    => "🟠",
        var s when s.Contains("çiçek") || s.Contains("cicek") => "🌸",
        var s when s.Contains("teknosa")  => "🔵",
        var s when s.Contains("n11")      => "🟣",
        var s when s.Contains("ptt")      => "🟡",
        _ => "🏪"
    };
}