@code {
    static readonly System.Globalization.CultureInfo trCulture = new("tr-TR");

    // ── Adım modeli ────────────────────────────────────────────
    enum AdimDurum { Bekliyor, Devam, Tamamlandi }
    class Adim
    {
        public string Metin { get; set; } = "";
        public AdimDurum Durum { get; set; } = AdimDurum.Bekliyor;
    }

    List<Adim> adimlar = new()
    {
        new() { Metin = "Chrome tarayıcısı başlatılıyor" },
        new() { Metin = "Sayfaya gidiliyor" },
        new() { Metin = "Sayfa yüklenmesi bekleniyor" },
        new() { Metin = "Ürün adı ve fiyat okunuyor" },
        new() { Metin = "Resim ve satıcı bilgisi alınıyor" },
    };
    int ilerleme = 0;

    // ── State ──────────────────────────────────────────────────
    List<Models.Kategori> dbKategoriler = new();
    List<string> kategoriler = new() { "Telefon", "Bilgisayar", "Elektronik", "Giyim", "Diğer" };
    string secilenKategori = "Telefon";

    string yeniLink = "";
    string mesaj = "";
    bool hataVar = false;
    bool yukleniyor = false;

    // Model bazlı kartlar (URL'den de TakipModeli'ne yazıldığı için her şey buraya düşer)
    List<TakipModelKart> modelKartlar = new();
    int? islemModelId = null;

    // ── Manuel birleştirme (Seçenek A) ──
    bool birlestirAcik = false;
    TakipModelKart? birlestirKaynak = null;
    int birlestirHedefId = 0;
    bool birlestirIslemDevam = false;

    protected override async Task OnInitializedAsync()
    {
        Oturum.Degisti += StateHasChanged;

        dbKategoriler = await KategoriServisi.GetAllAsync();
        if (dbKategoriler.Count == 0)
        {
            await KategoriServisi.SeedVarsayilanKategorilerAsync();
            dbKategoriler = await KategoriServisi.GetAllAsync();
        }
        kategoriler = dbKategoriler.Select(k => k.Ad).ToList();
        if (kategoriler.Any()) secilenKategori = kategoriler.First();

        if (Oturum.GirisYapildi)
            await VerileriYukle();
    }

    public void Dispose() => Oturum.Degisti -= StateHasChanged;

    async Task VerileriYukle()
    {
        if (!Oturum.GirisYapildi) return;
        var uid = Oturum.KullaniciId!.Value;

        // Tek liste: tüm takipler (kategorilerden + URL ile eklenenler birlikte)
        // URL eklemeleri de UrunModeli'ne bağlanıp TakipModeli kaydı oluşturduğu için
        // hepsi otomatik buraya düşer.
        modelKartlar = await TakipModeliServisi.GetKullaniciKartlariAsync(uid);
    }

    async Task EnterTusu(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UrunEkle();
    }

    async Task UrunEkle()
    {
        if (string.IsNullOrWhiteSpace(yeniLink)) return;

        var temizLink = yeniLink.Trim();

        var urlHatasi = ScraperService.UrunUrlHatasi(temizLink);
        if (urlHatasi != null)
        {
            mesaj = urlHatasi; hataVar = true; return;
        }

        // Bu URL zaten kullanıcının takiplerinde mi? Db'den kontrol
        var uid0 = Oturum.KullaniciId!.Value;
        var zatenVarUrl = await Db.Urunler.AnyAsync(u =>
            u.URL == temizLink && u.UserId == uid0 && u.Aktif);
        if (zatenVarUrl)
        {
            mesaj = "⚠ Bu URL'yi zaten eklemişsin."; hataVar = true; return;
        }

        var siteAdi = ScraperService.SiteAdi(ScraperService.SiteTespit(temizLink));
        adimlar[1].Metin = $"{siteAdi} sayfasına gidiliyor";
        foreach (var a in adimlar) a.Durum = AdimDurum.Bekliyor;
        ilerleme = 0;
        yukleniyor = true;
        mesaj = "";
        hataVar = false;

        var scrapeGorev = Scraper.GetUrunDetayAsync(temizLink);
        int[] bekleme = { 800, 1200, 2500, 1500, 1000 };
        for (int i = 0; i < adimlar.Count; i++)
        {
            adimlar[i].Durum = AdimDurum.Devam;
            ilerleme = (i + 1) * 18;
            StateHasChanged();
            await Task.Delay(bekleme[i]);
            if (scrapeGorev.IsCompleted) break;
            adimlar[i].Durum = AdimDurum.Tamamlandi;
        }

        try
        {
            var detay = await scrapeGorev;
            foreach (var a in adimlar) a.Durum = AdimDurum.Tamamlandi;
            ilerleme = 100;
            StateHasChanged();
            await Task.Delay(400);

            var kat = dbKategoriler.FirstOrDefault(k => k.Ad == secilenKategori) ?? dbKategoriler.FirstOrDefault();
            var katId = kat?.Id ?? 1;

            // ── Çift taraflı fayda: URL'yi kataloğa da entegre et ──
            // Aynı isimli model var mı bak (case-insensitive, in-memory karşılaştırma).
            // Varsa o modele yeni site listemesi olarak ekle, yoksa yeni UrunModeli yarat.
            var tumModeller = await Db.UrunModelleri.AsNoTracking().ToListAsync();
            var mevcutModel = tumModeller.FirstOrDefault(m =>
                string.Equals(m.Ad.Trim(), detay.Ad.Trim(), StringComparison.OrdinalIgnoreCase));

            int modelId;
            bool yeniModelOlustu = false;

            if (mevcutModel is not null)
            {
                modelId = mevcutModel.Id;
            }
            else
            {
                // Bu ürün katalogda henüz yok — yeni UrunModeli olarak ekle
                var yeniModel = new Models.UrunModeli
                {
                    Ad = detay.Ad,
                    KategoriId = katId,
                    Resim = detay.ResimUrl,
                    OlusturulmaTarihi = DateTime.UtcNow,
                    Aktif = true,
                };
                Db.UrunModelleri.Add(yeniModel);
                await Db.SaveChangesAsync();
                modelId = yeniModel.Id;
                yeniModelOlustu = true;
            }

            // Kullanıcı bu URL'yi zaten ekledi mi?
            var zatenVar = await Db.Urunler.AnyAsync(u =>
                u.URL == detay.Url && u.UserId == Oturum.KullaniciId && u.Aktif);

            if (zatenVar)
            {
                mesaj = "⚠ Bu URL'yi zaten eklemişsin.";
                hataVar = true;
                return;
            }

            var yeniUrun = new Models.Urun
            {
                Ad = detay.Ad,
                URL = detay.Url,
                Resim = detay.ResimUrl,
                Satici = detay.Satici,
                BaslangicFiyati = detay.FiyatSayi,
                SonFiyati = detay.FiyatSayi,
                ParaBirimi = "TRY",
                KategoriId = katId,
                UserId = Oturum.KullaniciId,
                UrunModeliId = modelId,    // ★ Modele bağla — kataloğa entegre
            };

            await UrunServisi.EkleAsync(yeniUrun);

            // Kullanıcıyı bu modele TakipModeli kaydı olarak da ekle — böylece
            // ana sayfa ve "Kategorilerden Takip Ettiklerim" bölümünde görünür.
            await TakipModeliServisi.TakipEkleAsync(Oturum.KullaniciId!.Value, modelId);

            await VerileriYukle();

            yeniLink = "";
            mesaj = yeniModelOlustu
                ? $"✅ \"{detay.Ad}\" hem takip listene hem de kataloğa eklendi!"
                : $"✅ \"{detay.Ad}\" takip listene eklendi (kataloğdaki modele bağlandı)";
            hataVar = false;
        }
        catch (Exception ex)
        {
            mesaj = $"Hata: {ex.Message}";
            hataVar = true;
        }
        finally
        {
            yukleniyor = false;
        }
    }

    /// <summary>İki ürün ismi arasındaki Dice benzerlik katsayısı (0..1).</summary>
    static decimal IsimBenzerlikSkoru(string a, string b)
    {
        var tokA = Tokenize(a);
        var tokB = Tokenize(b);
        if (tokA.Count == 0 || tokB.Count == 0) return 0;
        var kesisim = tokA.Intersect(tokB).Count();
        return (decimal)(2.0 * kesisim) / (tokA.Count + tokB.Count);
    }

    static HashSet<string> Tokenize(string s) =>
        new string(s.ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) ? c : ' ').ToArray())
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(t => t.Length > 1)
            .ToHashSet();

    // ── Seçenek A: Manuel birleştirme ─────────────────────────

    void BirlestirAc(TakipModelKart kart)
    {
        birlestirKaynak = kart;
        birlestirHedefId = 0;
        birlestirAcik = true;
        StateHasChanged();
    }

    void BirlestirIptal()
    {
        birlestirAcik = false;
        birlestirKaynak = null;
        birlestirHedefId = 0;
    }

    async Task BirlestirOnayla()
    {
        if (birlestirKaynak is null || birlestirHedefId == 0) return;
        birlestirIslemDevam = true;
        StateHasChanged();

        try
        {
            // Kaynak modelin Urun rows'larını hedef modele bağla
            var kaynakUrunler = await Db.Urunler
                .Where(u => u.UrunModeliId == birlestirKaynak.ModelId)
                .ToListAsync();

            foreach (var u in kaynakUrunler)
                u.UrunModeliId = birlestirHedefId;
            await Db.SaveChangesAsync();

            // Kaynak modelin TakipModeli kayıtlarını sil
            var kaynakTakipler = await Db.TakipModelleri
                .Where(t => t.UrunModeliId == birlestirKaynak.ModelId)
                .ToListAsync();
            Db.TakipModelleri.RemoveRange(kaynakTakipler);

            // Kaynak UrunModeli sil
            var kaynakModel = await Db.UrunModelleri.FirstOrDefaultAsync(m => m.Id == birlestirKaynak.ModelId);
            if (kaynakModel is not null)
                Db.UrunModelleri.Remove(kaynakModel);

            await Db.SaveChangesAsync();

            // Kullanıcı zaten hedef modeli takip etmiyorsa, takipe al
            var uid = Oturum.KullaniciId!.Value;
            await TakipModeliServisi.TakipEkleAsync(uid, birlestirHedefId);

            mesaj = "✅ Model başarıyla birleştirildi.";
            hataVar = false;
            birlestirAcik = false;
            birlestirKaynak = null;
            birlestirHedefId = 0;

            await VerileriYukle();
        }
        catch (Exception ex)
        {
            mesaj = "✗ Birleştirme başarısız oldu.";
            hataVar = true;
            Console.Error.WriteLine($"[Birleştir] {ex}");
        }
        finally
        {
            birlestirIslemDevam = false;
            StateHasChanged();
        }
    }

    async Task ModelTakipCik(TakipModelKart kart)
    {
        islemModelId = kart.TakipId;
        StateHasChanged();
        try
        {
            await TakipModeliServisi.TakiptenCikAsync(Oturum.KullaniciId!.Value, kart.ModelId);
            modelKartlar = modelKartlar.Where(k => k.TakipId != kart.TakipId).ToList();
        }
        finally
        {
            islemModelId = null;
            StateHasChanged();
        }
    }

    void Detaya(int modelId) => NavManager.NavigateTo($"/model/{modelId}");
    void Grafige(int urunId) => NavManager.NavigateTo($"/grafik/{urunId}");
    void GirisGit() => NavManager.NavigateTo("/hesap");

    static string SiteIkon(string satici) => satici.ToLowerInvariant() switch
    {
        var s when s.Contains("hepsi")    => "🟠",
        var s when s.Contains("çiçek") || s.Contains("cicek") => "🌸",
        var s when s.Contains("teknosa")  => "🔵",
        var s when s.Contains("n11")      => "🟣",
        var s when s.Contains("ptt")      => "🟡",
        _ => "🏪"
    };
}
