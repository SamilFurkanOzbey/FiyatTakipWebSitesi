@page "/kategoriler"
@rendermode InteractiveServer

<PageTitle>Kategoriler | Fiyat Takip</PageTitle>

<div class="kategori-page">
    <div class="sidebar">
        <div class="sidebar-header">
            <i class="bi bi-grid-fill"></i> KATEGORİLER
        </div>
        
        <div class="kategori-item @(secilenKategori == "Favoriler" ? "active" : "")"
             @onclick='() => KategoriSec("Favoriler")'>
            ⭐ Favori Ürünler
        </div>

        <hr style="border-color: #334155; margin: 10px 0;" />

        @foreach (var kat in kategoriListesi)
        {
            <div class="kategori-item @(secilenKategori == kat.Ad ? "active" : "")"
                 @onclick="() => KategoriSec(kat.Ad)">
                @kat.Emoji @kat.Ad
            </div>
        }
    </div>

    <div class="content">
        <div class="content-header">
            <h2>@(string.IsNullOrEmpty(secilenKategori) ? "Hoş Geldiniz" : secilenKategori)</h2>
        </div>

        @if (filtreliUrunler.Any())
        {
            <div class="urun-grid">
                @foreach (var urun in filtreliUrunler)
                {
                    <div class="urun-card">
                        <div class="card-img-container">
                            <img src="@urun.Resim" alt="@urun.Ad" />
                        </div>
                        <div class="card-info">
                            <h4>@urun.Ad</h4>
                            <p class="fiyat">@urun.Fiyat</p>
                            <div class="btn-row">
                                <NavLink href="/urundetay" class="detay-btn">Detay</NavLink>
                                <NavLink href="/Analiz" class="grafik-btn">Grafik</NavLink>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bos-durum">
                <span style="font-size: 50px;">👈</span>
                <p>Ürünleri görmek için bir kategori seçin</p>
            </div>
        }
    </div>
</div>

<style>
    .kategori-page { display: flex; min-height: 100vh; background: #0f172a; color: white; }
    
    /* SIDEBAR STİLLERİ */
    .sidebar { width: 280px; background: #111827; padding: 15px; border-right: 1px solid #1e293b; }
    .sidebar-header { font-size: 12px; color: #94a3b8; letter-spacing: 1px; margin-bottom: 20px; padding-left: 10px; }
    
    .kategori-item { 
        padding: 12px 15px; border-radius: 8px; margin-bottom: 5px; 
        cursor: pointer; transition: 0.3s; color: #cbd5e1; font-size: 15px;
    }
    .kategori-item:hover { background: #1e293b; color: white; }
    .kategori-item.active { background: #1e293b; color: #38bdf8; border-left: 4px solid #38bdf8; }

    /* İÇERİK ALANI STİLLERİ */
    .content { flex: 1; padding: 40px; }
    .content-header { margin-bottom: 30px; border-bottom: 1px solid #1e293b; padding-bottom: 15px; }
    
    .urun-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
    
    .urun-card { background: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #334155; transition: 0.3s; }
    .urun-card:hover { transform: translateY(-5px); border-color: #38bdf8; }
    
    .card-img-container { height: 180px; background: white; display: flex; align-items: center; justify-content: center; }
    .card-img-container img { max-width: 100%; max-height: 100%; object-fit: contain; }
    
    .card-info { padding: 15px; }
    .card-info h4 { font-size: 16px; margin-bottom: 10px; height: 40px; overflow: hidden; }
    .fiyat { color: #38bdf8; font-weight: bold; font-size: 1.1rem; }
    
    .btn-row { display: flex; gap: 8px; margin-top: 15px; }
    .detay-btn { background: #334155; flex:1; text-align:center; padding:8px; border-radius:6px; text-decoration:none; color:white; font-size:12px; }
    .grafik-btn { background: #0284c7; flex:1; text-align:center; padding:8px; border-radius:8px; text-decoration:none; color:white; font-size:12px; }

    .bos-durum { text-align: center; margin-top: 100px; color: #64748b; }
</style>

@code {
    string secilenKategori = "";
    List<Urun> tumUrunler = new();
    List<Urun> filtreliUrunler = new();

    // Kategori ve Emoji Yapısı
    List<KategoriModel> kategoriListesi = new()
    {
        new() { Ad = "Telefon", Emoji = "📱" },
        new() { Ad = "Laptop", Emoji = "💻" },
        new() { Ad = "Tablet", Emoji = "||" }, 
        new() { Ad = "Kulaklık", Emoji = "🎧" },
        new() { Ad = "Televizyon", Emoji = "📺" },
        new() { Ad = "Buzdolabı", Emoji = "🧊" },
        new() { Ad = "Çamaşır Makinesi", Emoji = "🧺" },
        new() { Ad = "Oyun Konsolu", Emoji = "🎮" },
        new() { Ad = "Kamera", Emoji = "📷" },
        new() { Ad = "Aksesuar", Emoji = "🔌" }
    };

    protected override void OnInitialized()
    {
        VerileriYukle();
        // Sayfa açıldığında Favoriler otomatik seçili gelsin
        KategoriSec("Favoriler");
    }

    void VerileriYukle()
    {
        // Örnek veriler (Backend gelene kadar)
        string[] urunIsimleri = { "iPhone 15 Pro", "Samsung S24 Ultra", "MacBook M3", "Sony XM5", "PlayStation 5", "iPad Air" };
        foreach (var isim in urunIsimleri)
        {
            tumUrunler.Add(new Urun { 
                Ad = isim, 
                Fiyat = "35.000 TL", 
                Kategori = "Favoriler", // Favori kategorisi için
                Resim = "https://picsum.photos/200/200?random=" + isim.Length 
            });
        }
        
        // Diğer dümenden veriler
        tumUrunler.Add(new Urun { Ad = "Logitech MX Master", Fiyat = "3.500 TL", Kategori = "Aksesuar", Resim = "https://picsum.photos/200/200" });
    }

    void KategoriSec(string kategori)
    {
        secilenKategori = kategori;
        filtreliUrunler = tumUrunler.Where(x => x.Kategori == kategori).ToList();
    }

    public class KategoriModel { public string Ad { get; set; } = ""; public string Emoji { get; set; } = ""; }
    public class Urun { public string Ad { get; set; } = ""; public string Fiyat { get; set; } = ""; public string Kategori { get; set; } = ""; public string Resim { get; set; } = ""; }
}