@page "/kategoriler"
@rendermode InteractiveServer
@inject FiyatTakipWebSitesi.Services.KategoriService KategoriServisi
@inject FiyatTakipWebSitesi.Services.UrunService UrunServisi
<PageTitle>Kategoriler</PageTitle>

<div class="kategori-page">
    <div class="sidebar">
        <h3>Kategoriler</h3>
        @foreach (var kategori in kategoriler)
        {
            <div class="kategori-item @(secilenKategori?.Id == kategori.Id ? "active" : "")"
                 @onclick="() => KategoriSec(kategori)">
                @kategori.Ad
            </div>
        }
    </div>

    <div class="content">
        @if (secilenKategori == null)
        {
            <h2>Kategori Seçiniz</h2>
            <p>Ürünleri listelemek için soldan bir başlığa tıklayın.</p>
        }
        else
        {
            <h2>@secilenKategori.Ad Bölümü</h2>
            @if (filtreliUrunler.Any())
            {
                <div class="urun-grid">
                    @foreach (var urun in filtreliUrunler)
                    {
                        <div class="urun-card">
                            @if (!string.IsNullOrEmpty(urun.Resim))
                            {
                                <img src="@urun.Resim" alt="@urun.Ad" />
                            }
                            else
                            {
                                <div class="resim-placeholder">🖼️</div>
                            }
                            <h4>@urun.Ad</h4>
                            <p class="fiyat">@urun.SonFiyati.ToString("N2") @urun.ParaBirimi</p>
                            <div class="btn-row">
                                <NavLink href="@($"/urundetay/{urun.Id}")" class="detay-btn">Detay</NavLink>
                                <NavLink href="@($"/grafik/{urun.Id}")" class="grafik-btn">Grafik</NavLink>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bos-mesaj">Bu kategori henüz doldurulmadı.</div>
            }
        }
    </div>
</div>

<style>
    .kategori-page { display: flex; min-height: 100vh; background: #0f172a; }
    .sidebar { width: 250px; background: #111827; padding: 20px; border-right: 1px solid #1e293b; }
    .kategori-item { color: white; background: #1e293b; padding: 15px; border-radius: 12px; margin-bottom: 10px; cursor: pointer; transition: 0.2s; }
    .kategori-item.active { background: #0284c7; }
    .content { flex: 1; padding: 30px; color: white; }
    .urun-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
    .urun-card { background: #1e293b; padding: 15px; border-radius: 15px; border: 1px solid #334155; }
    .urun-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 10px; }
    .resim-placeholder { width: 100%; height: 200px; background: #0f172a; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 3rem; }
    .fiyat { color: #38bdf8; font-weight: bold; }
    .btn-row { display: flex; gap: 8px; margin-top: 15px; }
    .detay-btn { background: #475569; flex:1; text-align:center; padding:8px; border-radius:8px; text-decoration:none; color:white; font-size:12px; transition: background 0.2s; }
    .detay-btn:hover { background: #64748b; }
    .grafik-btn { background: #0284c7; flex:1; text-align:center; padding:8px; border-radius:8px; text-decoration:none; color:white; font-size:12px; transition: background 0.2s; }
    .grafik-btn:hover { background: #0369a1; }
    .bos-mesaj { padding: 40px; text-align:center; color: #94a3b8; }
</style>

@code {
    List<FiyatTakipWebSitesi.Models.Kategori> kategoriler = new();
    List<FiyatTakipWebSitesi.Models.Urun> filtreliUrunler = new();
    FiyatTakipWebSitesi.Models.Kategori? secilenKategori;

    protected override async Task OnInitializedAsync()
    {
        kategoriler = await KategoriServisi.GetAllAsync();
        if (kategoriler.Any())
        {
            await KategoriSec(kategoriler.First());
        }
    }

    async Task KategoriSec(FiyatTakipWebSitesi.Models.Kategori kategori)
    {
        secilenKategori = kategori;
        filtreliUrunler = await UrunServisi.GetByKategoriAsync(kategori.Id);
    }
}