@page "/kategoriler"

<PageTitle>Kategoriler - Fiyat Takip</PageTitle>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
        <li class="breadcrumb-item active" aria-current="page">Kategoriler</li>
      </ol>
    </nav>

    <h2 class="mb-4 font-weight-bold">Tüm Kategoriler</h2>

    <div class="row g-3">
        @foreach (var kategori in kategoriler)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="p-4 border rounded text-center bg-white shadow-sm hover-shadow cursor-pointer">
                    <div class="fs-1 mb-2">@kategori.Icon</div>
                    <div class="fw-bold">@kategori.Ad</div>
                    <small class="text-muted">120+ Ürün</small>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // Örnek veri yapısı
    private List<KategoriItem> kategoriler = new()
    {
        new KategoriItem { Ad = "Elektronik", Icon = "📱" },
        new KategoriItem { Ad = "Moda", Icon = "👕" },
        new KategoriItem { Ad = "Ev & Yaşam", Icon = "🏠" },
        new KategoriItem { Ad = "Spor", Icon = "⚽" },
        new KategoriItem { Ad = "Kozmetik", Icon = "💄" },
        new KategoriItem { Ad = "Kitap", Icon = "📚" },
        new KategoriItem { Ad = "Hobi", Icon = "🎨" },
        new KategoriItem { Ad = "Otomobil", Icon = "🚗" }
    };

    public class KategoriItem
    {
        public string Ad { get; set; } = "";
        public string Icon { get; set; } = "";
    }
}

<style>
    .hover-shadow:hover {
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        border-color: #0d6efd !important;
        color: #0d6efd;
    }
    .cursor-pointer { cursor: pointer; }
</style>