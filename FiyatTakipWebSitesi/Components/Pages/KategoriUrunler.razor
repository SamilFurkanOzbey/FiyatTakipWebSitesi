@page "/kategoriler"
@rendermode InteractiveServer
@inject FiyatTakipWebSitesi.Services.UrunService UrunServisi
@inject FiyatTakipWebSitesi.Services.KategoriService KategoriServisi
@inject NavigationManager NavManager
<PageTitle>Kategoriler</PageTitle>

<div class="kategori-page">

    @* ── SOL: Kategori Listesi ── *@
    <div class="sidebar">
        <h3>📂 Kategoriler</h3>
        @if (kategoriler.Count == 0)
        {
            <p class="bilgi">Henüz kategori yok.</p>
        }
        else
        {
            @foreach (var kategori in kategoriler)
            {
                <div class="kategori-item @(secilenKategori?.Id == kategori.Id ? "active" : "")"
                     @onclick="() => KategoriSec(kategori)">
                    @kategori.Ad
                </div>
            }
        }
    </div>

    @* ── SAĞ: İçerik ── *@
    <div class="content">
        @if (secilenKategori is null)
        {
            <div class="bos-baslangic">
                <h2>👈 Soldan bir kategori seç</h2>
                <p>Kategoriye ait modelleri görmek için soldaki listeden bir başlığa tıkla.</p>
            </div>
        }
        else
        {
            <h2>@secilenKategori.Ad <span class="adet">@modeller.Count model</span></h2>

            @if (yukleniyor)
            {
                <div class="yukleme">⏳ Yükleniyor...</div>
            }
            else if (modeller.Count == 0)
            {
                <div class="bos-mesaj">
                    <p>Bu kategoride henüz model yok.</p>
                </div>
            }
            else
            {
                <div class="model-grid">
                    @foreach (var model in modeller)
                    {
                        var aktifListeler = model.Listeler.Where(l => l.Aktif && l.SonFiyati > 0).ToList();
                        var enDusukFiyat = aktifListeler.Any() ? aktifListeler.Min(l => l.SonFiyati) : 0;
                        var enDusukSatici = aktifListeler.Any()
                            ? aktifListeler.OrderBy(l => l.SonFiyati).First().Satici
                            : "";
                        // Resim için: önce modelin kendi resmi, yoksa ilk listelemenin resmi
                        var resim = !string.IsNullOrEmpty(model.Resim)
                            ? model.Resim
                            : model.Listeler.Select(l => l.Resim).FirstOrDefault(r => !string.IsNullOrEmpty(r));

                        <div class="model-card" @onclick="() => ModelDetayinaGit(model.Id)">
                            <div class="card-resim">
                                @if (!string.IsNullOrEmpty(resim))
                                {
                                    <img src="@resim" alt="@model.Ad" />
                                }
                                else
                                {
                                    <span class="placeholder">🖼️</span>
                                }
                            </div>
                            <div class="card-body">
                                <h4 title="@model.Ad">@model.Ad</h4>

                                @if (enDusukFiyat > 0)
                                {
                                    <p class="fiyat">
                                        <span class="fiyat-etiket">En düşük:</span>
                                        <span class="fiyat-deger">@enDusukFiyat.ToString("N2", trCulture) ₺</span>
                                    </p>
                                    <p class="satici">🏪 @enDusukSatici</p>
                                }
                                else
                                {
                                    <p class="fiyat-bekleniyor">Fiyat henüz çekilmedi</p>
                                }

                                <div class="alt-bar">
                                    <span class="site-badge">📍 @model.Listeler.Count(l => l.Aktif) sitede</span>
                                    <span class="detay-ok">Detaylar →</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<style>
    body { background: #0f172a; }

    .kategori-page {
        display: flex;
        min-height: calc(100vh - 60px);
        background: #0f172a;
        color: white;
    }

    /* ── Sidebar ── */
    .sidebar {
        width: 260px;
        background: #111827;
        padding: 24px 18px;
        border-right: 1px solid #1e293b;
        flex-shrink: 0;
    }
    .sidebar h3 {
        font-size: 1.1rem;
        margin-bottom: 18px;
        color: #f1f5f9;
    }
    .kategori-item {
        color: #cbd5e1;
        background: #1e293b;
        padding: 14px 16px;
        border-radius: 12px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: 500;
        border: 1px solid transparent;
    }
    .kategori-item:hover {
        background: #334155;
        color: white;
        border-color: #475569;
    }
    .kategori-item.active {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: white;
        border-color: #38bdf8;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
    }
    .bilgi { color: #64748b; font-size: 0.9rem; }

    /* ── İçerik ── */
    .content {
        flex: 1;
        padding: 32px 36px;
        overflow-y: auto;
    }
    .content h2 {
        font-size: 1.8rem;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .adet {
        background: #1e293b;
        color: #94a3b8;
        font-size: 0.85rem;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid #334155;
        font-weight: 500;
    }
    .bos-baslangic {
        padding: 80px 20px;
        text-align: center;
        color: #94a3b8;
    }
    .bos-baslangic h2 { color: #cbd5e1; margin-bottom: 12px; }
    .bos-mesaj, .yukleme {
        padding: 40px;
        text-align: center;
        background: #1e293b;
        border: 1px dashed #475569;
        border-radius: 16px;
        color: #94a3b8;
    }

    /* ── Model Kartları ── */
    .model-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 22px;
        animation: fadeIn 0.4s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .model-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 16px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
    }
    .model-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
        box-shadow: 0 12px 24px rgba(56, 189, 248, 0.15);
    }
    .card-resim {
        width: 100%;
        height: 180px;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .card-resim img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 12px;
    }
    .placeholder {
        font-size: 3rem;
        opacity: 0.4;
    }
    .card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }
    .card-body h4 {
        font-size: 0.98rem;
        font-weight: 600;
        color: #f1f5f9;
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.6em;
    }
    .fiyat { margin: 0; }
    .fiyat-etiket { color: #64748b; font-size: 0.78rem; font-weight: 500; }
    .fiyat-deger { color: #38bdf8; font-weight: 700; font-size: 1.2rem; margin-left: 6px; }
    .satici { color: #94a3b8; font-size: 0.8rem; margin: 0; }
    .fiyat-bekleniyor {
        color: #fbbf24;
        font-size: 0.85rem;
        font-style: italic;
        margin: 0;
    }
    .alt-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid #334155;
    }
    .site-badge {
        background: #334155;
        color: #cbd5e1;
        font-size: 0.72rem;
        padding: 3px 10px;
        border-radius: 999px;
        font-weight: 600;
    }
    .detay-ok {
        color: #64748b;
        font-size: 0.78rem;
        transition: color 0.2s ease;
    }
    .model-card:hover .detay-ok { color: #38bdf8; }
</style>

@code {
    List<FiyatTakipWebSitesi.Models.Kategori> kategoriler = new();
    List<FiyatTakipWebSitesi.Models.UrunModeli> modeller = new();
    FiyatTakipWebSitesi.Models.Kategori? secilenKategori = null;
    bool yukleniyor = false;

    // Türkçe sayı formatı için
    static readonly System.Globalization.CultureInfo trCulture =
        new System.Globalization.CultureInfo("tr-TR");

    protected override async Task OnInitializedAsync()
    {
        kategoriler = await KategoriServisi.GetAllAsync();
        if (!kategoriler.Any()) return;

        // ?kategori=ID query parametresi varsa o kategoriyi seç (ModelDetay
        // "Geri Dön" tuşundan dönüldüğünde kullanıcıyı doğru kategoriye atar).
        // Yoksa ilk kategoriyi otomatik seç (boş ekran karşılamasın).
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        FiyatTakipWebSitesi.Models.Kategori? hedef = null;
        if (query.TryGetValue("kategori", out var idStr) &&
            int.TryParse(idStr, out var kategoriId))
        {
            hedef = kategoriler.FirstOrDefault(k => k.Id == kategoriId);
        }

        await KategoriSec(hedef ?? kategoriler.First());
    }

    async Task KategoriSec(FiyatTakipWebSitesi.Models.Kategori kategori)
    {
        secilenKategori = kategori;
        yukleniyor = true;
        modeller = new();
        StateHasChanged();

        modeller = await UrunServisi.GetModellerByKategoriAsync(kategori.Id);
        yukleniyor = false;
        StateHasChanged();
    }

    void ModelDetayinaGit(int modelId)
    {
        NavManager.NavigateTo($"/model/{modelId}");
    }
}
