@page "/kategoriler"
@inject ScraperService Scraper
@rendermode InteractiveServer

<div class="kategori-sayfa">

    <!-- SOL: KATEGORİ PANELİ -->
    <div class="kategori-panel">
        <h5 class="panel-baslik">📦 Kategoriler</h5>
        @foreach (var kat in Kategoriler)
        {
            <div class="kategori-item @(SecilenKategori?.Ad == kat.Ad ? "aktif" : "")"
                 @onclick="() => KategoriSec(kat)">
                <span class="kat-icon">@kat.Icon</span>
                <span class="kat-ad">@kat.Ad</span>
            </div>
        }
    </div>

    <!-- SAĞ: ÜRÜN PANELİ -->
    <div class="urun-panel">
        @if (SecilenKategori == null)
        {
            <div class="bos-durum">
                <span>👈</span>
                <p>Ürünleri görmek için bir kategori seçin</p>
            </div>
        }
        else if (isLoading)
        {
            <div class="yukleniyor">
                <div class="spinner"></div>
                <p>@SecilenKategori.Ad kategorisi yükleniyor...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(Hata))
        {
            <div class="alert alert-danger">❌ @Hata</div>
        }
        else if (Urunler.Count == 0)
        {
            <div class="bos-durum">
                <span>🔍</span>
                <p>Bu kategoride ürün bulunamadı.</p>
            </div>
        }
        else
        {
            <div class="urun-baslik-row">
                <h5>🛍️ @SecilenKategori.Ad <span class="badge bg-secondary">@Urunler.Count ürün</span></h5>
            </div>
            <div class="urun-grid">
                @foreach (var urun in Urunler)
                {
                    <a href="@urun.UrunUrl" target="_blank" class="urun-kart">
                        @if (!string.IsNullOrEmpty(urun.ResimUrl))
                        {
                            <img src="@urun.ResimUrl" alt="@urun.Ad" class="urun-resim" />
                        }
                        else
                        {
                            <div class="urun-resim-yok">🖼️</div>
                        }
                        <div class="urun-bilgi">
                            <p class="urun-ad">@urun.Ad</p>
                            <p class="urun-fiyat">@urun.Fiyat</p>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<style>
    .kategori-sayfa {
        display: flex;
        height: calc(100vh - 80px);
        gap: 0;
        font-family: 'Segoe UI', sans-serif;
    }

    /* --- KATEGORİ PANELİ --- */
    .kategori-panel {
        width: 200px;
        min-width: 200px;
        background: #1a1a2e;
        border-right: 1px solid #2d2d4e;
        padding: 16px 0;
        overflow-y: auto;
    }

    .panel-baslik {
        color: #a0a0c0;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 0 16px 12px;
        border-bottom: 1px solid #2d2d4e;
        margin-bottom: 8px;
    }

    .kategori-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        cursor: pointer;
        color: #c0c0d8;
        transition: background 0.15s, color 0.15s;
        border-left: 3px solid transparent;
    }

    .kategori-item:hover {
        background: #2a2a4a;
        color: #fff;
    }

    .kategori-item.aktif {
        background: #2a2a4a;
        color: #7c83fd;
        border-left: 3px solid #7c83fd;
        font-weight: 600;
    }

    .kat-icon { font-size: 1.1rem; }
    .kat-ad { font-size: 0.88rem; }

    /* --- ÜRÜN PANELİ --- */
    .urun-panel {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: #0f0f1e;
    }

    .urun-baslik-row {
        margin-bottom: 16px;
    }

    .urun-baslik-row h5 {
        color: #e0e0f0;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .urun-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 16px;
    }

    .urun-kart {
        background: #1a1a2e;
        border: 1px solid #2d2d4e;
        border-radius: 10px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s, border-color 0.15s;
        display: flex;
        flex-direction: column;
    }

    .urun-kart:hover {
        transform: translateY(-3px);
        border-color: #7c83fd;
    }

    .urun-resim {
        width: 100%;
        height: 150px;
        object-fit: contain;
        background: #fff;
        padding: 8px;
    }

    .urun-resim-yok {
        width: 100%;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        background: #2a2a4a;
    }

    .urun-bilgi {
        padding: 10px;
        flex: 1;
    }

    .urun-ad {
        font-size: 0.78rem;
        color: #c0c0d8;
        margin: 0 0 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
    }

    .urun-fiyat {
        font-size: 0.95rem;
        font-weight: 700;
        color: #7c83fd;
        margin: 0;
    }

    /* --- DURUM EKRANLARI --- */
    .bos-durum {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #606080;
        gap: 12px;
        font-size: 0.95rem;
    }

    .bos-durum span { font-size: 3rem; }

    .yukleniyor {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #7c83fd;
        gap: 16px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #2d2d4e;
        border-top-color: #7c83fd;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    // Sabit kategori listesi - istediğin kadar ekleyebilirsin
    private List<KategoriItem> Kategoriler = new()
    {
        new("Telefon",       "📱", "https://www.hepsiburada.com/cep-telefonlari-c-371965"),
        new("Laptop",        "💻", "https://www.hepsiburada.com/laptop-notebook-c-2147483646"),
        new("Tablet",        "📟", "https://www.hepsiburada.com/tablet-c-371990"),
        new("Kulaklık",      "🎧", "https://www.hepsiburada.com/kulaklik-c-372009"),
        new("Televizyon",    "📺", "https://www.hepsiburada.com/televizyon-c-372004"),
        new("Buzdolabı",     "🧊", "https://www.hepsiburada.com/buzdolabi-c-371868"),
        new("Çamaşır Makinesi", "🫧", "https://www.hepsiburada.com/camasir-makinesi-c-371866"),
        new("Oyun Konsolu",  "🎮", "https://www.hepsiburada.com/oyun-konsolu-c-372012"),
        new("Kamera",        "📷", "https://www.hepsiburada.com/fotograf-makinesi-c-372001"),
        new("Aksesuar",      "🔌", "https://www.hepsiburada.com/telefon-aksesuar-c-372010"),
    };

    private KategoriItem? SecilenKategori;
    private List<UrunKart> Urunler = new();
    private bool isLoading = false;
    private string Hata = "";

    private async Task KategoriSec(KategoriItem kat)
    {
        if (isLoading) return;
        SecilenKategori = kat;
        Urunler.Clear();
        Hata = "";
        isLoading = true;

        try
        {
            Urunler = await Scraper.GetKategoriUrunleriAsync(kat.Url);
        }
        catch (Exception ex)
        {
            Hata = $"Ürünler yüklenirken hata oluştu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private record KategoriItem(string Ad, string Icon, string Url);
}
