@page "/kategoriler"
@rendermode InteractiveServer
<PageTitle>Kategoriler</PageTitle>

<div class="kategori-page">
    <div class="sidebar">
        <h3>Kategoriler</h3>
        @foreach (var kategori in kategoriler)
        {
            <div class="kategori-item @(secilenKategori == kategori ? "active" : "")"
                 @onclick="() => KategoriSec(kategori)">
                @kategori
            </div>
        }
    </div>

    <div class="content">
        @if (string.IsNullOrEmpty(secilenKategori))
        {
            <h2>Kategori Seçiniz</h2>
            <p>Ürünleri listelemek için soldan bir başlığa tıklayın.</p>
        }
        else
        {
            <h2>@secilenKategori Bölümü</h2>
            @if (filtreliUrunler.Any())
            {
                <div class="urun-grid">
                    @foreach (var urun in filtreliUrunler)
                    {
                        <div class="urun-card">
                            <img src="@urun.Resim" />
                            <h4>@urun.Ad</h4>
                            <p class="fiyat">@urun.Fiyat</p>
                            <div class="btn-row">
                                <NavLink href="/UrunDetaySayfasi" class="detay-btn">Detay</NavLink>
                                <NavLink href="/Analiz" class="grafik-btn">Grafik</NavLink>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bos-mesaj">Bu kategori henüz doldurulmadı.</div>
            }
        }
    </div>
</div>

<style>
    .kategori-page { display: flex; min-height: 100vh; background: #0f172a; }
    .sidebar { width: 250px; background: #111827; padding: 20px; border-right: 1px solid #1e293b; }
    .kategori-item { color: white; background: #1e293b; padding: 15px; border-radius: 12px; margin-bottom: 10px; cursor: pointer; transition: 0.2s; }
    .kategori-item.active { background: #0284c7; }
    .content { flex: 1; padding: 30px; color: white; }
    .urun-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
    .urun-card { background: #1e293b; padding: 15px; border-radius: 15px; border: 1px solid #334155; }
    .urun-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 10px; }
    .fiyat { color: #38bdf8; font-weight: bold; }
    .btn-row { display: flex; gap: 8px; margin-top: 15px; }
    .detay-btn { background: #475569; flex:1; text-align:center; padding:8px; border-radius:8px; text-decoration:none; color:white; font-size:12px; }
    .grafik-btn { background: #0284c7; flex:1; text-align:center; padding:8px; border-radius:8px; text-decoration:none; color:white; font-size:12px; }
    .bos-mesaj { padding: 40px; text-align:center; color: #94a3b8; }
</style>

@code {
    List<string> kategoriler = new() { "Elektronik", "Moda", "Ev", "Spor", "Kitap", "Kozmetik" };
    List<Urun> tumUrunler = new();
    List<Urun> filtreliUrunler = new();
    string secilenKategori = "";

    protected override void OnInitialized()
    {
        string[] elektronikler = { "iPhone 15", "MacBook Air", "Sony WH-1000XM5", "Logitech G502", "Razer BlackWidow", "Samsung Odyssey G7", "iPad Pro", "Apple Watch S9", "Samsung T7 SSD", "Logitech C920", "JBL Flip 6", "Meta Quest 3" };
        string[] modalar = { "Siyah Trençkot", "Oversize Hoodie", "Air Jordan 1", "Basic Beyaz Tişört", "Slim Fit Gömlek", "Chelsea Bot", "Ray-Ban Wayfarer", "North Face Çanta", "V Yaka Kazak", "Chino Pantolon", "Gece Elbisesi", "Kolombiya Mont" };

        for (int i = 0; i < 12; i++)
        {
            tumUrunler.Add(new Urun { Ad = elektronikler[i], Fiyat = "15.000 TL", Kategori = "Elektronik", Resim = $"https://picsum.photos/400/300?random=e{i}" });
            tumUrunler.Add(new Urun { Ad = modalar[i], Fiyat = "2.500 TL", Kategori = "Moda", Resim = $"https://picsum.photos/400/500?random=m{i}" });
        }
    }

    void KategoriSec(string kategori)
    {
        secilenKategori = kategori;
        filtreliUrunler = tumUrunler.Where(x => x.Kategori == kategori).ToList();
    }

    class Urun {
        public string Ad { get; set; } = "";
        public string Fiyat { get; set; } = "";
        public string Kategori { get; set; } = "";
        public string Resim { get; set; } = "";
    }
}