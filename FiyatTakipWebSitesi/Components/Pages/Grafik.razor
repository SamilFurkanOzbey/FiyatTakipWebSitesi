@page "/grafik"
@rendermode InteractiveServer
<PageTitle>Analiz</PageTitle>

<div class="grafik-page">

    ```
    <h1>📊 Fiyat Analizi</h1>

    <div class="grafik-card">

        <h4>iPhone 15 Pro Max</h4>

        <p class="fiyat">Güncel Fiyat: 89.999 TL</p>

        <div class="fake-chart">

            <div class="bar" style="height:40%"></div>
            <div class="bar" style="height:65%"></div>
            <div class="bar" style="height:50%"></div>
            <div class="bar" style="height:90%"></div>
            <div class="bar" style="height:70%"></div>

        </div>

        <p class="aciklama">
            Son 30 gündeki fiyat değişimi örneği.
        </p>

    </div>
    ```

</div>

<style>

    .grafik-page {
        min-height: 100vh;
        background: #0f172a;
        color: white;
        padding: 40px;
    }

    .grafik-card {
        background: #1e293b;
        padding: 30px;
        border-radius: 18px;
        margin-top: 30px;
    }

    .fiyat {
        color: #60a5fa;
        font-size: 1.4rem;
        font-weight: bold;
    }

    .fake-chart {
        display: flex;
        align-items: flex-end;
        gap: 15px;
        height: 300px;
        margin-top: 30px;
    }

    .bar {
        flex: 1;
        background: #2563eb;
        border-radius: 12px 12px 0 0;
    }

    .aciklama {
        margin-top: 20px;
        color: #94a3b8;
    }

</style>
