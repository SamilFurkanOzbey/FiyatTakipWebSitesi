@page "/"

<PageTitle>Ana Sayfa - Fiyat Takip</PageTitle>

<div class="container mt-4">
    <!-- Üst Kategori Barı -->
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <NavLink class="btn btn-primary me-3" href="kategoriler">
            <i class="bi bi-grid-fill"></i> Tüm Kategoriler
        </NavLink>
        
        <div class="d-flex gap-2 overflow-auto py-1">
            <span class="badge rounded-pill bg-light text-dark p-2 px-3 border cursor-pointer">Elektronik</span>
            <span class="badge rounded-pill bg-light text-dark p-2 px-3 border cursor-pointer">Moda</span>
            <span class="badge rounded-pill bg-light text-dark p-2 px-3 border cursor-pointer">Ev & Yaşam</span>
            <span class="badge rounded-pill bg-light text-dark p-2 px-3 border cursor-pointer">Kozmetik</span>
        </div>
    </div>

    <!-- Öne Çıkan Ürünler -->
    <h3 class="mb-4">Öne Çıkan Ürünler</h3>
    
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @for (int i = 1; i <= 4; i++)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="https://via.placeholder.com/200" class="card-img-top" alt="Ürün Görseli">
                    <div class="card-body">
                        <h5 class="card-title text-truncate">Örnek Ürün Başlığı @i</h5>
                        <p class="card-text text-primary fw-bold">1.250,00 TL</p>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                            <NavLink href="UrunDetay" class="btn btn-outline-secondary btn-sm flex-fill">
                                🔍 Detay
                            </NavLink>
                            <NavLink href="Grafik" class="btn btn-outline-primary btn-sm flex-fill">
                                📊 Analiz
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Link Takip Alanı -->
    <div class="mt-5 p-4 bg-light rounded-3 border">
        <h4><i class="bi bi-bell-fill text-warning"></i> Fiyat Takibi Başlat</h4>
        <p class="text-muted">Takip etmek istediğiniz ürünün linkini yapıştırın, fiyatı düşünce haber verelim.</p>
        <div class="input-group mb-3">
            <input type="text" class="form-control" placeholder="Ürün linkini buraya yapıştırın..." aria-label="Ürün linki">
            <button class="btn btn-success" type="button">Takip Et</button>
        </div>
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; transition: 0.2s; }
    .cursor-pointer:hover { background-color: #e9ecef !important; }
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-5px); }
</style>