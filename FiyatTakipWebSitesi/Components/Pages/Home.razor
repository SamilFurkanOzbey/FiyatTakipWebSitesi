@page "/"
@rendermode InteractiveServer
@inject FiyatTakipWebSitesi.Services.UrunService UrunServisi
@inject FiyatTakipWebSitesi.Services.KategoriService KategoriServisi
@inject FiyatTakipWebSitesi.Services.TakipModeliService TakipModeliServisi
@inject FiyatTakipWebSitesi.Services.OturumDurumu Oturum
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>ŞAM | Ana Sayfa</PageTitle>

<div class="home-container">
    
    <div class="version-tag">Fiyat Takip Sistemi v1.0</div>

    @* --- SPLIT HERO ALANI --- *@
    <div class="hero-split">
        @* SOL TARAF: Logo, Alt Alta Tek Satır Metinler, Butonlar ve Hemen Altında Kategoriler *@
        <div class="hero-left">
            <div class="home-logo">
                <span class="logo-icon">🛒</span>
                <span class="logo-main">ŞAM</span>
            </div>
            
            <p class="home-subtitle">
                <span class="sub-line">Hepsiburada, Çiçeksepeti, Teknosa, n11 ve PttAVM'den <span class="highlight-text">tek ekrandan</span> fiyat karşılaştır.</span>
                <span class="sub-line">Ürünün fiyatı düştüğünde anında <span class="highlight-text">e-posta</span> al.</span>
            </p>

            <div class="top-actions">
                <a href="/kategoriler" class="action-btn">
                    <span class="btn-icon">📦</span> Tüm Kategoriler
                </a>
                <a href="/takip" class="action-btn @(Oturum.GirisYapildi ? "" : "disabled-link")" title="@(Oturum.GirisYapildi ? "" : "Önce giriş yapmalısınız")">
                    <span class="btn-icon">⭐</span> Takip Ettiklerim
                </a>
            </div>

            @* ELİPS KATEGORİ HAPLARI *@
            <div class="category-pills">
                <button class="pill @(seciliKategoriId == 0 ? "active" : "")" @onclick="() => KategoriGetir(0)">
                    🔥 Popüler
                </button>

                @foreach (var kat in vitrinKategorileri)
                {
                    <button class="pill @(seciliKategoriId == kat.Id ? "active" : "")" @onclick="() => KategoriGetir(kat.Id)">
                        @kat.Ad
                    </button>
                }

                <a href="/kategoriler" class="pill-plus" title="Diğer Kategoriler">
                    +
                </a>
            </div>
        </div>

        @* SAĞ TARAF: Modern İstatistik Kartları *@
        <div class="hero-right">
            <div class="stat-grid">
                <div class="stat-card">
                    <span class="stat-number">@toplamModel</span>
                    <span class="stat-label">Model</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">5</span>
                    <span class="stat-label">SİTE</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@toplamKategori</span>
                    <span class="stat-label">Kategori</span>
                </div>
            </div>
        </div>
    </div>

    @* ÜRÜN LİSTELEME ALANI *@
    <div class="products-section">
        @if (yukleniyor)
        {
            <div class="bos-durum">
                <span style="font-size: 50px;">⏳</span>
                <p>Ürünler yükleniyor...</p>
            </div>
        }
        else if (aktifUrunler.Any())
        {
            <div class="urun-grid">
                @foreach (var urun in aktifUrunler)
                {
                    <div class="urun-card" @onclick="() => Detaya(urun)">
                        <div class="card-img-container">
                            @if (!string.IsNullOrEmpty(urun.Resim))
                            {
                                <img src="@urun.Resim" alt="@urun.Ad" />
                            }
                            else
                            {
                                <span style="font-size:60px; opacity:0.2;">🛍️</span>
                            }
                        </div>
                        <div class="card-info">
                            <h4 title="@urun.Ad">@urun.Ad</h4>
                            <p class="fiyat">@urun.Fiyat</p>
                            @if (!string.IsNullOrEmpty(urun.AltBilgi))
                            {
                                <p class="alt-bilgi">@urun.AltBilgi</p>
                            }

                            @if (urun.ModelId > 0)
                            {
                                @if (urun.TakipEdiliyor)
                                {
                                    <button class="takip-btn takip-edildi"
                                            @onclick="() => TakiptenCik(urun)"
                                            @onclick:stopPropagation="true"
                                            disabled="@urun.IslemDevam">
                                        @if (urun.IslemDevam)
                                        {
                                            <span>⏳ Kaldırılıyor...</span>
                                        }
                                        else
                                        {
                                            <span class="durum-varsayilan"><span class="yesil-tik">✓</span> Takip Ediliyor</span>
                                            <span class="durum-hover">✕ Takipten Çık</span>
                                        }
                                    </button>
                                }
                                else
                                {
                                    <button class="takip-btn"
                                            @onclick="() => TakipEt(urun)"
                                            @onclick:stopPropagation="true"
                                            disabled="@urun.IslemDevam">
                                        @(urun.IslemDevam ? "⏳ Ekleniyor..." : "📌 Takip Et")
                                    </button>
                                }
                            }

                            <div class="btn-row">
                                <NavLink href="@urun.DetayLink" class="detay-btn" @onclick:stopPropagation="true">🔍 Detay</NavLink>
                                <NavLink href="@urun.GrafikLink" class="grafik-btn" @onclick:stopPropagation="true">📈 Grafik</NavLink>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bos-durum">
                <span style="font-size: 50px;">📭</span>
                <p>Bu alanda henüz ürün yok.</p>
            </div>
        }
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@800&display=swap');

    .home-container {
        padding: 40px 20px;
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
    }

    .version-tag {
        position: absolute;
        top: 0;
        right: 20px;
        background: #2a2a2e;
        color: #9ba4b5;
        padding: 4px 12px;
        border-radius: 0 0 8px 8px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid #4a4a4c;
        border-top: none;
    }

    /* SPLIT HERO STİLLERİ */
    .hero-split {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-top: 20px;
        margin-bottom: 30px;
        padding: 20px 0;
        gap: 40px;
    }

    .hero-left {
        flex: 1.2;
        text-align: left;
    }

    .hero-right {
        flex: 0.8;
        display: flex;
        justify-content: flex-end;
        margin-top: 15px;
    }

    .home-logo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Montserrat', sans-serif;
        font-size: 3.5rem;
        letter-spacing: -3px;
        color: #ffffff;
        margin-bottom: 15px;
    }
    .logo-main { color: #ffffff; }
    .logo-icon { font-size: 3rem; filter: drop-shadow(0px 0px 10px rgba(23, 162, 184, 0.8)); }

    /* CÜMLE YERLEŞİM AYARLARI */
    .home-subtitle {
        color: #9ba4b5;
        font-size: 1.1rem;
        margin-bottom: 25px;
        line-height: 1.8;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    
    .sub-line {
        display: block;
        white-space: nowrap;
    }

    .highlight-text {
        color: #17a2b8;
        font-weight: 700;
    }

    .top-actions {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
    }

    .action-btn {
        background: #252526;
        color: #ffffff;
        border: 1px solid #4a4a4c;
        padding: 12px 24px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .action-btn:hover { background: #3e3e42; border-color: #9ba4b5; transform: translateY(-2px); }
    .disabled-link { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

    /* İstatistik Kartları */
    .stat-grid {
        display: flex;
        gap: 15px;
    }

    .stat-card {
        background: #2a2a2e;
        border: 1px solid #4a4a4c;
        border-radius: 16px;
        padding: 20px 25px;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        transition: transform 0.3s ease, border-color 0.3s ease;
        min-width: 110px;
    }
    
    .stat-card:hover { transform: translateY(-5px); border-color: #17a2b8; }
    .stat-number { color: #17a2b8; font-size: 2.2rem; font-weight: 800; font-family: 'Montserrat', sans-serif; line-height: 1; margin-bottom: 5px; text-shadow: 0 0 10px rgba(23, 162, 184, 0.3); }
    .stat-label { color: #b3b3b3; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; }

    /* ELİPS KATEGORİ HAPLARI */
    .category-pills {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }
    .pill { background: #2a2a2e; color: #d1d1d1; border: 1px solid #4a4a4c; padding: 10px 24px; border-radius: 999px; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.3s ease; }
    .pill:hover { background: #3e3e42; color: #ffffff; }
    .pill.active { background: #ffffff; color: #1a1a1a; border-color: #ffffff; box-shadow: 0 0 15px rgba(255,255,255,0.2); }
    .pill-plus { width: 42px; height: 42px; background: #2a2a2e; color: #d1d1d1; border: 1px solid #4a4a4c; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 400; text-decoration: none; transition: all 0.3s ease; }
    .pill-plus:hover { background: #3e3e42; color: #ffffff; border-color: #9ba4b5; transform: rotate(90deg); }

    /* KART STİLLERİ */
    .urun-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
    .urun-card { background: #252526; border-radius: 12px; overflow: hidden; border: 1px solid #4a4a4c; transition: 0.3s; cursor: pointer; }
    .urun-card:hover { transform: translateY(-5px); border-color: #9ba4b5; box-shadow: 0 8px 15px rgba(0,0,0,0.2); }
    .card-img-container { height: 200px; background: #ffffff; display: flex; align-items: center; justify-content: center; padding: 12px; }
    .card-img-container img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .card-info { padding: 16px; }
    .card-info h4 { font-size: 15px; margin-bottom: 10px; color: #ffffff; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8em; }
    .fiyat { color: #ffffff; font-weight: 800; font-size: 1.25rem; margin: 0 0 4px; }
    .alt-bilgi { color: #9ba4b5; font-size: 0.85rem; margin: 0 0 12px; font-weight: 500; }

    .takip-btn { width: 100%; background: #2a2a2e; color: #ffffff; border: 1px solid #5c5c5c; padding: 14px; border-radius: 8px; font-size: 17px; font-weight: 700; cursor: pointer; transition: all 0.25s ease; margin-top: 4px; }
    .takip-btn:hover:not(:disabled) { background: #3a3a3e; }
    .takip-btn:disabled { cursor: not-allowed; opacity: 0.6; }
    .takip-btn.takip-edildi { background: #2a2a2e; color: #ffffff; border: 2px solid #4ade80; box-shadow: 0 0 10px rgba(74, 222, 128, 0.4); }
    .yesil-tik { color: #4ade80; font-weight: 900; margin-right: 4px; font-size: 18px; }
    .takip-btn.takip-edildi:hover:not(:disabled) { background: #4a1010; color: #fca5a5; border: 2px solid #ef4444; box-shadow: 0 0 12px rgba(239, 68, 68, 0.6); }
    .takip-btn.takip-edildi .durum-hover { display: none; }
    .takip-btn.takip-edildi:hover:not(:disabled) .durum-varsayilan { display: none; }
    .takip-btn.takip-edildi:hover:not(:disabled) .durum-hover { display: inline; }

    .btn-row { display: flex; gap: 8px; margin-top: 12px; }
    .detay-btn { background: #333333; flex: 1; text-align: center; padding: 8px; border-radius: 6px; border: 1px solid #4a4a4c; text-decoration: none; color: #d1d1d1; font-size: 13px; transition: all 0.2s; font-weight: 600;}
    .grafik-btn { background: #2b2b2b; flex: 1; text-align: center; padding: 8px; border-radius: 6px; border: 1px solid #4a4a4c; text-decoration: none; color: #d1d1d1; font-size: 13px; transition: all 0.2s; font-weight: 600;}
    .detay-btn:hover, .grafik-btn:hover { background: #4a4a4c; color: #ffffff; border-color: #9ba4b5; }

    .bos-durum { text-align: center; margin-top: 60px; color: #7a7a7a; }
    .bos-durum p { margin: 10px 0; font-size: 1.1rem; }

    /* Mobil responsive iyileştirmesi */
    @@media (max-width: 900px) {
        .hero-split { flex-direction: column; text-align: center; gap: 20px; }
        .hero-left { text-align: center; }
        .sub-line { white-space: normal; } 
        .top-actions { justify-content: center; }
        .category-pills { justify-content: center; }
        .hero-right { justify-content: center; width: 100%; }
        .stat-grid { width: 100%; justify-content: center; }
    }
</style>

@code {
    static readonly System.Globalization.CultureInfo trCulture = new("tr-TR");
    
    int seciliKategoriId = 0;
    bool yukleniyor = true;
    
    int toplamModel = 0;
    int toplamSite = 0;
    int toplamKategori = 0;

    List<FiyatTakipWebSitesi.Models.Kategori> vitrinKategorileri = new();
    List<UrunKart> aktifUrunler = new();
    List<FiyatTakipWebSitesi.Models.Kategori> tumKategoriler = new();

    protected override async Task OnInitializedAsync()
    {
        Oturum.Degisti += UpdateUi;
        
        tumKategoriler = await KategoriServisi.GetAllAsync();
        toplamKategori = tumKategoriler.Count;
        vitrinKategorileri = tumKategoriler.Take(3).ToList();

        await IstatistikleriHesapla();
        await KategoriGetir(0);
    }

    public void Dispose() => Oturum.Degisti -= UpdateUi;
    void UpdateUi() => InvokeAsync(StateHasChanged);

    async Task IstatistikleriHesapla()
    {
        int modelSayisi = 0;
        int siteSayisi = 0;
        
        foreach (var k in tumKategoriler)
        {
            var ms = await UrunServisi.GetModellerByKategoriAsync(k.Id);
            modelSayisi += ms.Count();
            siteSayisi += ms.SelectMany(m => m.Listeler).Count(l => l.Aktif);
        }
        
        toplamModel = modelSayisi;
        toplamSite = siteSayisi;
    }

    async Task KategoriGetir(int katId)
    {
        seciliKategoriId = katId;
        yukleniyor = true;
        StateHasChanged();

        if (katId == 0)
        {
            var tumModeller = new List<FiyatTakipWebSitesi.Models.UrunModeli>();
            foreach (var k in tumKategoriler)
            {
                tumModeller.AddRange(await UrunServisi.GetModellerByKategoriAsync(k.Id));
            }
            var populerModeller = tumModeller.OrderByDescending(x => x.Listeler.Count).Take(8).ToList();
            await KartlariDoldur(populerModeller);
        }
        else
        {
            var kategoriModelleri = await UrunServisi.GetModellerByKategoriAsync(katId);
            await KartlariDoldur(kategoriModelleri.Take(8).ToList());
        }

        yukleniyor = false;
        StateHasChanged();
    }

    async Task KartlariDoldur(List<FiyatTakipWebSitesi.Models.UrunModeli> hamModeller)
    {
        HashSet<int> takipModelIdleri = new();
        if (Oturum.GirisYapildi)
        {
            takipModelIdleri = await TakipModeliServisi.KullaniciTakipModelIdleriAsync(Oturum.KullaniciId!.Value);
        }

        aktifUrunler = hamModeller.Select(m =>
        {
            var aktifListeler = m.Listeler.Where(l => l.Aktif && l.SonFiyati > 0).ToList();
            decimal? enDusuk = aktifListeler.Any() ? aktifListeler.Min(l => l.SonFiyati) : (decimal?)null;
            var saticiCount = m.Listeler.Count(l => l.Aktif);
            var modelUrls = m.Listeler.Select(l => l.URL).ToList();
            var resim = !string.IsNullOrEmpty(m.Resim) ? m.Resim : m.Listeler.Select(l => l.Resim).FirstOrDefault(r => !string.IsNullOrEmpty(r)) ?? "";

            return new UrunKart
            {
                ModelId = m.Id,
                ModelUrlleri = modelUrls,
                TakipEdiliyor = takipModelIdleri.Contains(m.Id),
                Ad = m.Ad,
                Resim = resim,
                Fiyat = enDusuk.HasValue ? $"{enDusuk.Value.ToString("N2", trCulture)} ₺" : "Fiyat bekleniyor",
                AltBilgi = saticiCount > 0 ? $"📍 {saticiCount} sitede" : "",
                DetayLink = $"/model/{m.Id}",
                GrafikLink = aktifListeler.Any() ? $"/grafik/{aktifListeler.OrderBy(l => l.SonFiyati).First().Id}" : $"/model/{m.Id}"
            };
        }).ToList();
    }

    void Detaya(UrunKart kart) => NavManager.NavigateTo(kart.DetayLink);

    async Task TakipEt(UrunKart kart)
    {
        if (!Oturum.GirisYapildi)
        {
            NavManager.NavigateTo("/hesap");
            return;
        }
        
        kart.IslemDevam = true;
        StateHasChanged();
        
        try
        {
            await TakipModeliServisi.TakipEkleAsync(Oturum.KullaniciId!.Value, kart.ModelId);
            kart.TakipEdiliyor = true;
        }
        finally
        {
            kart.IslemDevam = false;
            StateHasChanged();
        }
    }

    async Task TakiptenCik(UrunKart kart)
    {
        if (!Oturum.GirisYapildi) return;
        
        kart.IslemDevam = true;
        StateHasChanged();
        
        try
        {
            await TakipModeliServisi.TakiptenCikAsync(Oturum.KullaniciId!.Value, kart.ModelId);
            kart.TakipEdiliyor = false;
        }
        finally
        {
            kart.IslemDevam = false;
            StateHasChanged();
        }
    }

    class UrunKart
    {
        public int ModelId { get; set; }
        public List<string> ModelUrlleri { get; set; } = new();
        public bool TakipEdiliyor { get; set; }
        public bool IslemDevam { get; set; }
        public string Ad { get; set; } = "";
        public string Resim { get; set; } = "";
        public string Fiyat { get; set; } = "";
        public string AltBilgi { get; set; } = "";
        public string DetayLink { get; set; } = "";
        public string GrafikLink { get; set; } = "";
    }
}