@* =====================================================
   Home.razor — Hibrit ana sayfa
   1) Hero: başlık + 3 CTA buton
   2) Özellikler: 3 ikon kart (otomatik, mail, karşılaştırma)
   3) Kişisel:
      - Giriş varsa  → Senin Takipteki Ürünler (ilk 4)
      - Giriş yoksa  → Popüler Ürünler (ilk 4 model)
   ===================================================== *@
@page "/"
@rendermode InteractiveServer
@inject FiyatTakipWebSitesi.Services.UrunService UrunServisi
@inject FiyatTakipWebSitesi.Services.KategoriService KategoriServisi
@inject FiyatTakipWebSitesi.Services.TakipModeliService TakipModeliServisi
@inject FiyatTakipWebSitesi.Services.OturumDurumu Oturum
@inject NavigationManager NavManager
@implements IDisposable
<PageTitle>ŞAM</PageTitle>

<div class="anasayfa">

    @* ── HERO ────────────────────────────────────── *@
    <section class="hero">
        <div class="hero-icerik">
            <div class="hero-rozet">📊 Fiyat Takip Sistemi · v1.0</div>
            <h1>📊 ŞAM</h1>
            <p class="hero-alt">
                Hepsiburada, Çiçeksepeti, Teknosa, n11 ve PttAVM'den
                <strong>tek ekrandan</strong> fiyat karşılaştır.
                <br />Ürünün fiyatı düştüğünde anında <strong>e-posta</strong> al.
            </p>

            <div class="hero-btnler">
                <a href="/kategoriler" class="btn-hero birincil">📦 Kategorilere Gözat</a>
                @if (Oturum.GirisYapildi)
                {
                    <a href="/takip" class="btn-hero ikincil">⭐ Takip Ettiklerim</a>
                }
                else
                {
                    <a href="/hesap" class="btn-hero ikincil">🔑 Kayıt Ol / Giriş Yap</a>
                }
            </div>

            <div class="istatistik">
                <div class="istat-blok">
                    <span class="istat-rakam">@toplamModel</span>
                    <span class="istat-yazi">Model</span>
                </div>
                <div class="istat-blok">
                    <span class="istat-rakam">@toplamSite</span>
                    <span class="istat-yazi">Site</span>
                </div>
                <div class="istat-blok">
                    <span class="istat-rakam">@toplamKategori</span>
                    <span class="istat-yazi">Kategori</span>
                </div>
            </div>
        </div>
    </section>

    @* ── ÖZELLİKLER ──────────────────────────────── *@
    <section class="ozellikler">
        <div class="ozellik">
            <div class="ozellik-ikon">🤖</div>
            <h3>Otomatik Takip</h3>
            <p>Sistem arka planda 5 büyük e-ticaret sitesini sürekli izler, fiyatları güncel tutar.</p>
        </div>
        <div class="ozellik">
            <div class="ozellik-ikon">📧</div>
            <h3>Email Bildirim</h3>
            <p>Takipteki ürünün fiyatı düşünce anında e-posta kutuna düşer, fırsatı kaçırmazsın.</p>
        </div>
        <div class="ozellik">
            <div class="ozellik-ikon">🏆</div>
            <h3>En Ucuzu Bul</h3>
            <p>Her ürünün tüm sitelerdeki fiyatını yan yana gör, anlık en iyi fiyatı keşfet.</p>
        </div>
    </section>

    @* ── BÖLÜM 1: Senin Takipteki Ürünler (giriş varsa ve takip varsa) ─ *@
    @if (Oturum.GirisYapildi && takiptekiler.Count > 0)
    {
        <section class="kisisel">
            <header class="kisisel-baslik">
                <div>
                    <h2>⭐ Senin Takipteki Ürünler</h2>
                    <p>@takiptekiler.Count modeli takip ediyorsun</p>
                </div>
                <a href="/takip" class="hepsi-link">Hepsini Gör →</a>
            </header>

            <div class="urun-grid">
                @foreach (var k in takiptekiler.Take(4))
                {
                    <div class="urun-kart takipte" @onclick="() => Detay(k.ModelId)">
                        <div class="takipte-rozet-mini">📌 TAKİPTE</div>
                        <div class="kart-resim">
                            @if (!string.IsNullOrEmpty(k.Resim))
                            {
                                <img src="@k.Resim" alt="@k.ModelAd" />
                            }
                            else
                            {
                                <span class="placeholder">🖼️</span>
                            }
                        </div>
                        <div class="kart-bilgi">
                            <span class="kategori-mini">@k.KategoriAd</span>
                            <h4 title="@k.ModelAd">@k.ModelAd</h4>
                            @if (k.EnUcuzFiyat.HasValue)
                            {
                                <p class="kart-fiyat yesil">@k.EnUcuzFiyat.Value.ToString("N2", trCulture) ₺</p>
                                <p class="kart-altbilgi">🏪 @k.EnUcuzSatici</p>
                            }
                            else
                            {
                                <p class="kart-bekleniyor">Fiyat bekleniyor</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @* ── BÖLÜM 2: Popüler Modeller (HER ZAMAN gösterilir) ─────── *@
    <section class="kisisel">
        <header class="kisisel-baslik">
            <div>
                <h2>🔥 Popüler Modeller</h2>
                <p>Sistemde en aktif izlenen ürünler</p>
            </div>
            <a href="/kategoriler" class="hepsi-link">Tüm Kataloğa Gözat →</a>
        </header>

        @if (populer.Count == 0)
        {
            <div class="bos-blok">
                <div style="font-size:3rem;">📭</div>
                <p>Henüz katalogda ürün yok.</p>
            </div>
        }
        else
        {
            <div class="urun-grid">
                @foreach (var m in populer)
                {
                    <div class="urun-kart" @onclick="() => Detay(m.ModelId)">
                        <div class="kart-resim">
                            @if (!string.IsNullOrEmpty(m.Resim))
                            {
                                <img src="@m.Resim" alt="@m.ModelAd" />
                            }
                            else
                            {
                                <span class="placeholder">🖼️</span>
                            }
                        </div>
                        <div class="kart-bilgi">
                            <span class="kategori-mini">@m.KategoriAd</span>
                            <h4 title="@m.ModelAd">@m.ModelAd</h4>
                            @if (m.EnUcuzFiyat.HasValue)
                            {
                                <p class="kart-fiyat">@m.EnUcuzFiyat.Value.ToString("N2", trCulture) ₺</p>
                                <p class="kart-altbilgi">📍 @m.SiteSayisi sitede</p>
                            }
                            else
                            {
                                <p class="kart-bekleniyor">Fiyat bekleniyor</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* ── BÖLÜM 3: CTA Alt (sadece giriş yapmamışlar için) ───── *@
    @if (!Oturum.GirisYapildi)
    {
        <section class="kisisel">
            <div class="cta-alt">
                <h3>Hemen Başla</h3>
                <p>Ücretsiz hesap aç, sevdiğin ürünleri takibe al, fiyat düşünce mail al.</p>
                <a href="/hesap" class="btn-hero birincil">🚀 Hesap Oluştur</a>
            </div>
        </section>
    }
</div>

<style>
    body { background: #0f172a; }

    .anasayfa {
        background: #0f172a;
        color: white;
        min-height: 100vh;
    }

    /* ── HERO ── */
    .hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #312e81 100%);
        padding: 70px 40px 60px;
        position: relative;
        overflow: hidden;
    }
    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(56, 189, 248, 0.2), transparent 60%);
        pointer-events: none;
    }
    .hero-icerik { position: relative; max-width: 1100px; margin: 0 auto; text-align: center; }
    .hero-rozet {
        display: inline-block;
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        margin-bottom: 18px;
        border: 1px solid rgba(56, 189, 248, 0.3);
        letter-spacing: 0.5px;
    }
    .hero h1 {
        font-size: 3.2rem;
        margin: 0 0 18px;
        color: #f1f5f9;
        font-weight: 800;
        background: linear-gradient(135deg, #f1f5f9, #38bdf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-alt {
        font-size: 1.15rem;
        color: #cbd5e1;
        max-width: 700px;
        margin: 0 auto 30px;
        line-height: 1.6;
    }
    .hero-alt strong { color: #38bdf8; }

    .hero-btnler {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 36px;
    }
    .btn-hero {
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.98rem;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-hero.kucuk { padding: 11px 22px; font-size: 0.9rem; margin-top: 10px; }
    .btn-hero.birincil {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: white;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4);
    }
    .btn-hero.birincil:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(2, 132, 199, 0.5);
        color: white;
    }
    .btn-hero.ikincil {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #475569;
    }
    .btn-hero.ikincil:hover {
        background: #334155;
        color: white;
        border-color: #38bdf8;
    }

    .istatistik {
        display: flex;
        justify-content: center;
        gap: 50px;
        flex-wrap: wrap;
        margin-top: 8px;
    }
    .istat-blok { display: flex; flex-direction: column; align-items: center; }
    .istat-rakam {
        color: #38bdf8;
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1;
    }
    .istat-yazi {
        color: #64748b;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 6px;
    }

    /* ── ÖZELLİKLER ── */
    .ozellikler {
        max-width: 1100px;
        margin: -30px auto 0;
        padding: 0 30px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        position: relative;
    }
    .ozellik {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 16px;
        padding: 26px 22px;
        text-align: center;
        transition: all 0.2s;
    }
    .ozellik:hover {
        transform: translateY(-3px);
        border-color: #38bdf8;
        box-shadow: 0 10px 24px rgba(56, 189, 248, 0.1);
    }
    .ozellik-ikon { font-size: 2.6rem; margin-bottom: 10px; }
    .ozellik h3 { color: #f1f5f9; font-size: 1.05rem; margin: 0 0 8px; }
    .ozellik p { color: #94a3b8; font-size: 0.88rem; margin: 0; line-height: 1.55; }

    /* ── KİŞİSEL ── */
    .kisisel {
        max-width: 1200px;
        margin: 50px auto;
        padding: 0 30px;
    }
    .kisisel-baslik {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .kisisel-baslik h2 {
        font-size: 1.6rem;
        color: #f1f5f9;
        margin: 0 0 4px;
    }
    .kisisel-baslik p {
        color: #94a3b8;
        margin: 0;
        font-size: 0.92rem;
    }
    .hepsi-link {
        color: #38bdf8;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
    .hepsi-link:hover { color: #7dd3fc; text-decoration: underline; }

    .bos-blok {
        background: #1e293b;
        border: 1px dashed #475569;
        border-radius: 16px;
        padding: 40px 30px;
        text-align: center;
        color: #94a3b8;
    }
    .bos-blok p { margin: 12px 0; }

    /* ── Ürün kartları (Home — kompakt) ── */
    .urun-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }
    .urun-kart {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.25s;
        display: flex; flex-direction: column;
        position: relative;
    }
    .urun-kart:hover {
        transform: translateY(-3px);
        border-color: #38bdf8;
        box-shadow: 0 10px 22px rgba(56, 189, 248, 0.15);
    }
    /* Takipteki kart için yeşil aksan + rozet */
    .urun-kart.takipte {
        border-left: 4px solid #16a34a;
    }
    .urun-kart.takipte:hover {
        border-color: #4ade80;
        border-left-color: #4ade80;
        box-shadow: 0 10px 22px rgba(74, 222, 128, 0.18);
    }
    .takipte-rozet-mini {
        position: absolute; top: 8px; right: 8px;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: white;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        box-shadow: 0 2px 6px rgba(22, 163, 74, 0.45);
        z-index: 2;
    }
    .kart-fiyat.yesil { color: #4ade80; }
    .kart-resim {
        width: 100%; height: 170px;
        background: white;
        display: flex; align-items: center; justify-content: center;
    }
    .kart-resim img { max-width: 100%; max-height: 100%; object-fit: contain; padding: 12px; }
    .placeholder { font-size: 2.6rem; opacity: 0.4; }
    .kart-bilgi { padding: 14px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
    .kategori-mini {
        align-self: flex-start;
        background: #0f172a;
        color: #94a3b8;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        border: 1px solid #334155;
    }
    .kart-bilgi h4 {
        margin: 4px 0; color: #f1f5f9;
        font-size: 0.92rem; font-weight: 600; line-height: 1.3;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden; min-height: 2.5em;
    }
    .kart-fiyat {
        color: #38bdf8; font-size: 1.18rem; font-weight: 800;
        margin: 4px 0 2px;
    }
    .kart-altbilgi {
        color: #94a3b8; font-size: 0.76rem; margin: 0;
    }
    .kart-bekleniyor {
        color: #fbbf24; font-size: 0.85rem; font-style: italic; margin: 4px 0;
    }

    /* ── CTA Alt (giriş yapmamış için) ── */
    .cta-alt {
        background: linear-gradient(135deg, #1e3a8a, #312e81);
        border: 1px solid #38bdf8;
        border-radius: 18px;
        padding: 38px 30px;
        text-align: center;
        margin-top: 40px;
    }
    .cta-alt h3 {
        color: #f1f5f9;
        font-size: 1.5rem;
        margin: 0 0 8px;
    }
    .cta-alt p { color: #cbd5e1; margin: 0 0 6px; }

    /* ── Responsive ── */
    @@media (max-width: 1024px) {
        .urun-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 768px) {
        .hero { padding: 50px 24px 50px; }
        .hero h1 { font-size: 2.2rem; }
        .ozellikler { grid-template-columns: 1fr; padding: 0 24px; margin-top: -20px; }
        .urun-grid { grid-template-columns: repeat(2, 1fr); }
        .istatistik { gap: 24px; }
    }
    @@media (max-width: 480px) {
        .urun-grid { grid-template-columns: 1fr; }
        .hero h1 { font-size: 1.8rem; }
    }
</style>

@code {
    static readonly System.Globalization.CultureInfo trCulture = new("tr-TR");

    int toplamModel = 0;
    int toplamSite = 0;
    int toplamKategori = 0;
    List<TakipModelKart> takiptekiler = new();
    List<PopulerKart> populer = new();

    protected override async Task OnInitializedAsync()
    {
        Oturum.Degisti += UpdateUi;
        await VerileriYukle();
    }

    public void Dispose() => Oturum.Degisti -= UpdateUi;

    void UpdateUi() => InvokeAsync(StateHasChanged);

    async Task VerileriYukle()
    {
        // İstatistikler — herkese
        var kategoriler = await KategoriServisi.GetAllAsync();
        toplamKategori = kategoriler.Count;

        // Tüm modelleri tek seferde topla (hem istatistik hem popüler için)
        var tumModeller = new List<PopulerKart>();
        var distinctSiteler = new HashSet<FiyatTakipWebSitesi.Services.ScraperService.Site>();
        foreach (var k in kategoriler)
        {
            var ms = await UrunServisi.GetModellerByKategoriAsync(k.Id);
            foreach (var url in ms.SelectMany(m => m.Listeler.Where(l => l.Aktif)).Select(l => l.URL))
            {
                var site = FiyatTakipWebSitesi.Services.ScraperService.SiteTespit(url);
                if (site != FiyatTakipWebSitesi.Services.ScraperService.Site.Bilinmiyor)
                    distinctSiteler.Add(site);
            }
            foreach (var m in ms)
            {
                var aktifListeler = m.Listeler.Where(l => l.Aktif && l.SonFiyati > 0).ToList();
                var enDusuk = aktifListeler.Any() ? aktifListeler.Min(l => l.SonFiyati) : (decimal?)null;
                var resim = !string.IsNullOrEmpty(m.Resim)
                    ? m.Resim
                    : m.Listeler.Select(l => l.Resim).FirstOrDefault(r => !string.IsNullOrEmpty(r)) ?? "";

                tumModeller.Add(new PopulerKart
                {
                    ModelId = m.Id,
                    ModelAd = m.Ad,
                    Resim = resim,
                    KategoriAd = k.Ad,
                    EnUcuzFiyat = enDusuk,
                    SiteSayisi = m.Listeler.Count(l => l.Aktif),
                });
            }
        }
        toplamModel = tumModeller.Count;
        toplamSite = distinctSiteler.Count;

        // Popüler: fiyatlıları öne al, en yüksek fiyatlı 4'ü göster (premium ürünler)
        populer = tumModeller
            .OrderByDescending(p => p.EnUcuzFiyat.HasValue)
            .ThenByDescending(p => p.EnUcuzFiyat ?? 0)
            .Take(4)
            .ToList();

        // Giriş yapmış kullanıcı için kişisel takipler
        if (Oturum.GirisYapildi)
        {
            takiptekiler = await TakipModeliServisi.GetKullaniciKartlariAsync(Oturum.KullaniciId!.Value);
        }
        else
        {
            takiptekiler = new();
        }
    }

    void Detay(int modelId) => NavManager.NavigateTo($"/model/{modelId}");

    class PopulerKart
    {
        public int ModelId { get; set; }
        public string ModelAd { get; set; } = "";
        public string Resim { get; set; } = "";
        public string KategoriAd { get; set; } = "";
        public decimal? EnUcuzFiyat { get; set; }
        public int SiteSayisi { get; set; }
    }
}
