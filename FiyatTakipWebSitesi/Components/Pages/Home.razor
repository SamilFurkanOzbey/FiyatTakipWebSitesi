@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>Ana Sayfa | Fiyat Takip</PageTitle>

<div class="home-container">

    <div class="hero">
        <h1>Fiyat Takip</h1>
        <p>Ürünleri incele ve fiyat geçmişlerini takip et.</p>
    </div>

    <NavLink href="/kategoriler" class="tum-kategori-btn">
        Tüm Kategoriler
    </NavLink>

    <div class="kategori-row">
        <button class="kategori-btn seed-btn" @onclick="OrnekVeriYukle" title="Veritabanı boşsa örnek veri doldurur">
            📦 Örnek Veri Yükle (Seed)
        </button>

        @foreach (var kategori in kategoriler)
        {
            <button class="kategori-btn @(secilenKategori == kategori ? "active" : "")"
                    @onclick="() => KategoriToggle(kategori)">
                @kategori @(secilenKategori == kategori ? "▲" : "▼")
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(secilenKategori) && gosterilenUrunler.Any())
    {
        <div class="urun-grid">
            @foreach (var urun in gosterilenUrunler)
            {
                <div class="urun-card">
                    <button class="takip-btn" title="Takibe Al" @onclick="() => TakibeEkle(urun)">
                        <i class="bi bi-plus-lg">+</i>
                        <span class="tooltip-text">Takibe Al</span>
                    </button>

                    <img src="@urun.Resim" alt="@urun.Ad" />
                    <h4>@urun.Ad</h4>
                    <p class="fiyat">@urun.Fiyat</p>

                    <div class="btn-row">
                        <NavLink href="/urundetay" class="detay-btn">Detay</NavLink>
                        <NavLink href="/grafik" class="grafik-btn">Grafik</NavLink>
                    </div>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(secilenKategori))
    {
        <div class="bos-uyari">
            <p>Bu kategori için örnek veriler hazırlanıyor...</p>
        </div>
    }

</div>

<style>
    body { background: #0f172a; color: white; font-family: 'Segoe UI'; }
    .home-container { padding: 30px; }
    .hero h1 { font-size: 42px; font-weight: bold; }
    .hero p { color: #94a3b8; margin-bottom: 20px; }
    
    .tum-kategori-btn { 
        display: inline-block; background: #334155; color: white; 
        text-decoration: none; padding: 10px 20px; border-radius: 10px; 
        margin-bottom: 30px; font-size: 14px; transition: 0.3s;
    }
    .tum-kategori-btn:hover { background: #475569; }

    .kategori-row { display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 30px; }
    
    .kategori-btn { 
        background: #1e293b; color: white; border: 2px solid #334155; 
        padding: 12px 22px; border-radius: 14px; cursor: pointer; 
        font-size: 16px; transition: 0.3s;
    }
    .kategori-btn.active { background: #0284c7; border-color: #38bdf8; }

    /* Seed butonu özel stili */
    .seed-btn { background: #059669; border-color: #047857; color: #fff; font-weight:bold; }
    .seed-btn:hover { background: #10b981; }

    .urun-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }

    .urun-card { 
        background: #1e293b; padding: 15px; border-radius: 18px; 
        border: 1px solid #334155; position: relative; transition: 0.3s;
    }

    .takip-btn {
        position: absolute; top: 15px; right: 15px; width: 35px; height: 35px;
        border-radius: 50%; background: #38bdf8; color: #0f172a; border: none;
        font-weight: bold; font-size: 20px; cursor: pointer; z-index: 10;
        display: flex; align-items: center; justify-content: center;
        transition: 0.3s;
    }
    .takip-btn:hover { transform: scale(1.1); background: #0ea5e9; }

    .tooltip-text {
        visibility: hidden; width: 80px; background-color: #334155;
        color: #fff; text-align: center; border-radius: 6px;
        padding: 5px; position: absolute; z-index: 11;
        bottom: 125%; left: 50%; margin-left: -40px; opacity: 0;
        transition: opacity 0.3s; font-size: 12px;
    }
    .takip-btn:hover .tooltip-text { visibility: visible; opacity: 1; }

    .urun-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 12px; }
    .fiyat { color: #38bdf8; font-weight: bold; font-size: 1.2rem; margin: 10px 0; }
    .btn-row { display: flex; gap: 10px; margin-top: 15px; }
    .detay-btn { background: #475569; flex:1; text-align:center; padding:10px; border-radius:10px; text-decoration:none; color:white; }
    .grafik-btn { background: #0284c7; flex:1; text-align:center; padding:10px; border-radius:10px; text-decoration:none; color:white; }
</style>

@code {
    List<string> kategoriler = new() { "Elektronik", "Moda", "Ev", "Spor", "Kitap", "Kozmetik" };
    List<Urun> tumUrunler = new();
    List<Urun> gosterilenUrunler = new();
    string secilenKategori = "";

    protected override void OnInitialized()
    {
        UrunleriYukle();
        KategoriSec("Elektronik");
    }

    async Task OrnekVeriYukle()
    {
        UrunleriYukle();
        KategoriSec("Elektronik");
    }

    void UrunleriYukle()
    {
        tumUrunler.Clear();
        string[] elektronikler = { "iPhone 15", "MacBook Air", "Sony WH-1000XM5", "Logitech G502", "Razer BlackWidow", "Samsung Odyssey G7", "iPad Pro", "Apple Watch S9", "Samsung T7 SSD", "Logitech C920", "JBL Flip 6", "Meta Quest 3" };
        string[] modalar = { "Siyah Trençkot", "Oversize Hoodie", "Air Jordan 1", "Basic Beyaz Tişört", "Slim Fit Gömlek", "Chelsea Bot", "Ray-Ban Wayfarer", "North Face Çanta", "V Yaka Kazak", "Chino Pantolon", "Gece Elbisesi", "Kolombiya Mont" };

        for (int i = 0; i < 12; i++)
        {
            tumUrunler.Add(new Urun { Ad = elektronikler[i], Fiyat = $"{15000 + (i * 500)} TL", Kategori = "Elektronik", Resim = $"https://picsum.photos/400/300?random=e{i}" });
            tumUrunler.Add(new Urun { Ad = modalar[i], Fiyat = $"{1200 + (i * 100)} TL", Kategori = "Moda", Resim = $"https://picsum.photos/400/600?random=m{i}" });
        }
    }

    void KategoriSec(string kategori)
    {
        secilenKategori = kategori;
        gosterilenUrunler = tumUrunler.Where(x => x.Kategori == kategori).ToList();
    }

    void KategoriToggle(string kategori)
    {
        if (secilenKategori == kategori)
        {
            secilenKategori = "";
            gosterilenUrunler.Clear();
        }
        else
        {
            KategoriSec(kategori);
        }
    }

    void TakibeEkle(Urun urun)
    {
        NavManager.NavigateTo("/takip");
    }

    class Urun {
        public string Ad { get; set; } = "";
        public string Fiyat { get; set; } = "";
        public string Kategori { get; set; } = "";
        public string Resim { get; set; } = "";
    }
}