@page "/fiyat-sorgula"
@inject ScraperService Scraper
@rendermode InteractiveServer

<h3>🔍 Fiyat Takip</h3>

@* Kullanıcının Hepsiburada ürün linkini gireceği metin kutusu *@
<div class="mb-3">
    <input @bind="productUrl"
           @bind:event="oninput"
           @onkeydown="EnterTusu"
           placeholder="Hepsiburada ürün URL'si girin..."
           class="form-control"
           disabled="@isLoading" />
</div>

@* Fiyat sorgulama işlemini başlatan buton *@
<button @onclick="FiyatGetir"
        class="btn btn-primary"
        disabled="@(isLoading || string.IsNullOrWhiteSpace(productUrl))">
    @(isLoading ? "⏳ Yükleniyor..." : "Fiyat Getir")
</button>

@* Sonuç kartı — tüm bilgiler başarıyla alındıysa göster *@
@if (detay != null)
{
    <div class="sonuc-kart mt-4">

        @* Ürün resmi *@
        @if (!string.IsNullOrEmpty(detay.ResimUrl))
        {
            <img src="@detay.ResimUrl" alt="@detay.Ad" class="urun-resim" />
        }
        else
        {
            <div class="resim-yok">🖼️</div>
        }

        <div class="urun-bilgi">
            @* Ürün adı *@
            <p class="urun-ad">@detay.Ad</p>

            @* Satıcı *@
            <p class="satici">🏪 @detay.Satici</p>

            @* Fiyat *@
            <p class="fiyat">💰 @detay.Fiyat</p>

            @* Ürün linkine git butonu *@
            <a href="@detay.Url" target="_blank" class="btn btn-outline-secondary btn-sm mt-2">
                🔗 Ürüne Git
            </a>
        </div>
    </div>
}

@* Hata varsa göster *@
@if (!string.IsNullOrEmpty(hata))
{
    <div class="alert alert-danger mt-3">❌ @hata</div>
}

<style>
    .sonuc-kart {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        background: #1a1a2e;
        border: 1px solid #2d2d4e;
        border-radius: 12px;
        padding: 20px;
        max-width: 600px;
        color: #e0e0f0;
        font-family: 'Segoe UI', sans-serif;
    }

    .urun-resim {
        width: 140px;
        height: 140px;
        object-fit: contain;
        background: #fff;
        border-radius: 8px;
        padding: 6px;
        flex-shrink: 0;
    }

    .resim-yok {
        width: 140px;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        background: #2a2a4a;
        border-radius: 8px;
        flex-shrink: 0;
    }

    .urun-bilgi {
        flex: 1;
    }

    .urun-ad {
        font-size: 0.95rem;
        font-weight: 600;
        color: #e0e0f0;
        margin: 0 0 10px;
        line-height: 1.4;
    }

    .satici {
        font-size: 0.85rem;
        color: #a0a0c0;
        margin: 0 0 8px;
    }

    .fiyat {
        font-size: 1.4rem;
        font-weight: 700;
        color: #7c83fd;
        margin: 0 0 8px;
    }
</style>

@code {
    string productUrl = "";
    string hata = "";
    bool isLoading = false;
    UrunDetay? detay = null; // Tüm ürün bilgilerini tutar

    async Task EnterTusu(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FiyatGetir();
    }

    async Task FiyatGetir()
    {
        if (string.IsNullOrWhiteSpace(productUrl)) return;

        isLoading = true;
        detay = null;
        hata = "";

        try
        {
            // Fiyat + ad + resim + satıcı hepsini tek seferde çek
            detay = await Scraper.GetUrunDetayAsync(productUrl);
        }
        catch (Exception ex)
        {
            hata = $"Hata: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
