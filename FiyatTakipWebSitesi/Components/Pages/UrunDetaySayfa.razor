@page "/urundetay"
@rendermode InteractiveServer
<PageTitle>Ürün Detayı</PageTitle>

<div class="container mt-5">

    <div class="card shadow-lg border-0 p-4">

        <div class="row g-4">

            <!-- ÜRÜN GÖRSELİ -->
            <div class="col-md-4 text-center">

                <img src="@urun.ResimUrl"
                     class="img-fluid rounded"
                     style="max-height:300px; object-fit:contain;" />

            </div>

            <!-- ÜRÜN BİLGİLERİ -->
            <div class="col-md-8">

                <h2 class="fw-bold">
                    @urun.Ad
                </h2>

                <h3 class="text-primary mt-3 fw-bold">
                    @urun.Fiyat
                </h3>

                <p class="mt-3 text-muted">
                    Satıcı:
                    <span class="fw-semibold">
                        @urun.Satici
                    </span>
                </p>

                <hr />

                <p>
                    Bu alanda ürünün detaylı açıklamaları,
                    fiyat değişimleri ve analiz bilgileri gösterilecek.
                </p>

                <div class="d-flex gap-2 mt-4">

                    <!-- GRAFİK -->
                    <NavLink href="/grafik"
                             class="btn btn-primary">
                        📊 Grafik
                    </NavLink>

                    <!-- ÜRÜN LİNKİ -->
                    <a href="@urun.Url"
                           target="_blank"
                           class="btn btn-success">
                        🔗 Ürüne Git
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    UrunBilgi urun = new()
    {
        Ad = "iPhone 15 Pro Max",
        Fiyat = "89.999 TL",
        Satici = "Teknosa",
        Url = "https://www.teknosa.com/",
        ResimUrl = "https://via.placeholder.com/500"
    };

    public class UrunBilgi
    {
        public string Ad { get; set; } = "";
        public string Fiyat { get; set; } = "";
        public string Satici { get; set; } = "";
        public string Url { get; set; } = "";
        public string ResimUrl { get; set; } = "";
    }

}