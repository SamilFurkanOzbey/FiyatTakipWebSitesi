@rendermode InteractiveServer
@inject FiyatTakipWebSitesi.Services.KategoriService KategoriServisi
@inject FiyatTakipWebSitesi.Services.OturumDurumu Oturum
@inject NavigationManager NavManager
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ŞAM</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                🏠 Ana Sayfa
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/kategoriler" Match="NavLinkMatch.Prefix">
                📦 Kategoriler
            </NavLink>
        </div>

        @* Kategoriler sayfasındaysa altta kategori listesi açılır *@
        @if (KategorilerSayfasinda())
        {
            <div class="alt-menu">
                @foreach (var kat in dbKategoriler)
                {
                    <NavLink class="alt-link"
                             href="@($"/kategoriler?kategori={kat.Id}")"
                             Match="NavLinkMatch.All">
                        <span class="alt-ikon">@(string.IsNullOrEmpty(kat.Icon) ? "📦" : kat.Icon)</span>
                        @kat.Ad
                    </NavLink>
                }
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/takip">
                ⭐ Takip Ettiklerim
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/hesap">
                👤 Hesap
            </NavLink>
        </div>

    </nav>
</div>

<style>
    .alt-menu {
        background: #0f172a;
        border-left: 3px solid #38bdf8;
        margin: 4px 12px 8px 22px;
        padding: 6px 4px;
        border-radius: 0 8px 8px 0;
    }
    .alt-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        color: #94a3b8;
        text-decoration: none;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.2s;
        margin: 2px 0;
    }
    .alt-link:hover {
        background: #1e293b;
        color: #cbd5e1;
    }
    .alt-link.active {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: white;
        font-weight: 600;
    }
    .alt-ikon { font-size: 1.05rem; flex-shrink: 0; }
</style>

@code {
    List<FiyatTakipWebSitesi.Models.Kategori> dbKategoriler = new();

    protected override async Task OnInitializedAsync()
    {
        dbKategoriler = await KategoriServisi.GetAllAsync();
        NavManager.LocationChanged += OnLocationChanged;
        Oturum.Degisti += UpdateUi;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        Oturum.Degisti -= UpdateUi;
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => UpdateUi();

    void UpdateUi() => InvokeAsync(StateHasChanged);

    bool KategorilerSayfasinda()
    {
        var path = NavManager.ToBaseRelativePath(NavManager.Uri);
        return path.StartsWith("kategoriler", StringComparison.OrdinalIgnoreCase);
    }
}
